<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760"
            prefWidth="1280"
            style="-fx-background-color: #F7F8FC;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.nhanvien.NhanVienController">

    <left>
        <VBox prefWidth="235"
              spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets bottom="20" left="20" right="15" top="25" />
            </padding>

            <Label style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"
                   text="SMART BANK" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #C9C9DD;"
                   text="YOUR SMART BANKING" />

            <Region prefHeight="15" />

            <VBox spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;">

                <Label style="-fx-font-size: 11px;
                              -fx-text-fill: #BDBDD2;"
                       text="Xin chào" />

                <Label style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"
                       text="Người dùng" />
            </VBox>

            <Region prefHeight="10" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #BDBDD2;
                          -fx-padding: 0 0 5 5;"
                   text="MENU" />

            <VBox spacing="4" VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTrangChu"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Trang chủ">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onKhachHang"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Khách hàng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChuyenTien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chuyển tiền">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTraCuuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Tra cứu giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLichSuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Lịch sử giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onHanMuc"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Hạn mức">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLoaiGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Loại giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChiNhanh"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chi nhánh">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onNhanVien"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"
                        text="Nhân viên">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onBaoCao"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Báo cáo">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onDoiMatKhau"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Đổi mật khẩu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>

            <Button alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#onDangXuat"
                    style="-fx-background-color: transparent;
                           -fx-background-radius: 10;
                           -fx-text-fill: #D0D0E0;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"
                    text="Đăng xuất">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
        </VBox>
    </left>

    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets bottom="30" left="35" right="35" top="30" />
            </padding>

            <top>
                <VBox spacing="5">
                    <Label style="-fx-font-size: 27px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #171A35;"
                           text="Nhân viên" />

                    <Label style="-fx-font-size: 13px;
                                  -fx-text-fill: #85879A;"
                           text="Quản lý thông tin nhân viên của ngân hàng" />
                </VBox>
            </top>

            <center>
                <VBox spacing="18">

                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                        <padding>
                            <Insets bottom="20" left="25" right="25" top="20" />
                        </padding>

                        <Label style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"
                               text="Thông tin nhân viên" />

                        <HBox spacing="15">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Mã nhân viên" />

                                <TextField fx:id="txtMaNhanVien"
                                           onAction="#onTimKiemTheoMa"
                                           promptText="Nhập mã nhân viên"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Họ tên" />

                                <TextField fx:id="txtHoTen"
                                           onAction="#onTimKiemTheoTen"
                                           promptText="Nhập họ tên nhân viên"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Số điện thoại" />

                                <TextField fx:id="txtSoDienThoai"
                                           onAction="#onTimKiemTheoSDT"
                                           promptText="Nhập số điện thoại"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>
                        </HBox>

                        <HBox spacing="15">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Chức vụ" />

                                <TextField fx:id="txtMaNhanVien1"
                                           onAction="#onTimKiemTheoChucVu"
                                           promptText="Nhập chức vụ"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Tên chi nhánh" />

                                <TextField fx:id="txtHoTen1"
                                           onAction="#onTimKiemTheoTenChiNhanh"
                                           promptText="Nhập tên chi nhánh"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"
                                       text="Tên đăng nhập" />

                                <TextField fx:id="txtSoDienThoai1"
                                           onAction="#onTimKiemTheoTenDangNhap"
                                           promptText="Nhập tên đăng nhập"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;" />
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <Button fx:id="btnTimKiem"
                                    onAction="#onTimKiem"
                                    prefHeight="40"
                                    prefWidth="100"
                                    style="-fx-background-color: #5148C9;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"
                                    text="Tìm">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnThem1"
                                    onAction="#onThem"
                                    prefHeight="40"
                                    prefWidth="100"
                                    style="-fx-background-color: #5148C9;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"
                                    text="+ Thêm">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnSua"
                                    onAction="#onSua"
                                    prefHeight="40"
                                    prefWidth="90"
                                    style="-fx-background-color: #ECEBFA;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: #5148C9;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"
                                    text="Sửa">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnXoa"
                                    onAction="#onXoa"
                                    prefHeight="40"
                                    prefWidth="90"
                                    style="-fx-background-color: #FDECEC;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: #D9534F;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"
                                    text="Xóa">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnLamMoi"
                                    onAction="#onLamMoi"
                                    prefHeight="40"
                                    prefWidth="100"
                                    style="-fx-background-color: #F1F2F6;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: #555A70;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"
                                    text="Làm mới">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                        </HBox>
                    </VBox>

                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);"
                          VBox.vgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"
                               text="Danh sách nhân viên" />

                        <TableView fx:id="tblNhanVien" VBox.vgrow="ALWAYS">

                            <columns>
                                <TableColumn fx:id="colMaNhanVien"
                                             prefWidth="150"
                                             text="Mã nhân viên" />

                                <TableColumn fx:id="colHoTen"
                                             prefWidth="250"
                                             text="Họ tên" />

                                <TableColumn fx:id="colSoDienThoai"
                                             prefWidth="200"
                                             text="Số điện thoại" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>