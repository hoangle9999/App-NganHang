<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1280" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.nhanvien.ChangePasswordController">
    <left>
        <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets bottom="20" left="20" right="15" top="25" />
            </padding>

            <Label style="-fx-font-size: 24px;                           -fx-font-weight: bold;                           -fx-text-fill: white;" text="SMART BANK" />

            <Label style="-fx-font-size: 10px;                           -fx-text-fill: #C9C9DD;" text="YOUR SMART BANKING" />

            <Region prefHeight="15" />

            <VBox spacing="4" style="-fx-background-color: rgba(255,255,255,0.08);                          -fx-background-radius: 12;                          -fx-padding: 12 15;">

                <Label style="-fx-font-size: 11px;                               -fx-text-fill: #BFC2D8;" text="Xin chào" />

                <Label style="-fx-font-size: 15px;                               -fx-font-weight: bold;                               -fx-text-fill: white;" text="Người dùng" />

            </VBox>

            <Region prefHeight="10" />

            <Label style="-fx-font-size: 10px;                           -fx-text-fill: #8F93AF;                           -fx-font-weight: bold;                           -fx-padding: 0 0 5 5;" text="MENU" />

            <VBox spacing="4" VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTrangChu" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Trang chủ">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onKhachHang" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Khách hàng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onChuyenTien" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Chuyển tiền">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Tra cứu giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLichSuGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Lịch sử giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHanMuc" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Hạn mức">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLoaiGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Loại giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onChiNhanh" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Chi nhánh">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onNhanVien" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Nhân viên">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onBaoCao" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Báo cáo">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDoiMatKhau" style="-fx-background-color: rgba(255,255,255,0.15);                                -fx-background-radius: 10;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-cursor: hand;" text="Đổi mật khẩu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

            </VBox>

            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-size: 13px;                            -fx-padding: 10 12;                            -fx-background-radius: 10;                            -fx-cursor: hand;" text="Đăng xuất">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets bottom="30" left="35" right="35" top="30" />
            </padding>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #171A35;                               -fx-font-size: 26px;                               -fx-font-weight: bold;" text="Đổi mật khẩu" />

                <Label style="-fx-text-fill: #777B91;                               -fx-font-size: 13px;" text="Cập nhật mật khẩu đăng nhập của tài khoản" />
            </VBox>

            <VBox maxWidth="650" spacing="18" style="-fx-background-color: white;                          -fx-background-radius: 20;                          -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                <padding>
                    <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
                </padding>

                <Label style="-fx-text-fill: #171A35;                               -fx-font-size: 18px;                               -fx-font-weight: bold;" text="Thông tin mật khẩu" />

                <VBox spacing="7">
                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Tên đăng nhập" />

                    <PasswordField fx:id="txtTenDangNhap" prefHeight="45" promptText="Nhập tên đăng nhập" style="-fx-background-color: white;                                           -fx-background-radius: 13;                                           -fx-border-color: #E0E1E8;                                           -fx-border-radius: 13;                                           -fx-padding: 0 15;" />
                </VBox>

                <VBox spacing="7">
                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Mật khẩu hiện tại" />

                    <PasswordField fx:id="txtMatKhauCu1" prefHeight="45" promptText="Nhập mật khẩu hiện tại" style="-fx-background-color: white;                                           -fx-background-radius: 13;                                           -fx-border-color: #E0E1E8;                                           -fx-border-radius: 13;                                           -fx-padding: 0 15;" />
                </VBox>

                <VBox spacing="7">
                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Mật khẩu mới" />

                    <PasswordField fx:id="txtMatKhauMoi" prefHeight="45" promptText="Nhập mật khẩu mới" style="-fx-background-color: white;                                           -fx-background-radius: 13;                                           -fx-border-color: #E0E1E8;                                           -fx-border-radius: 13;                                           -fx-padding: 0 15;" />
                </VBox>

                <VBox spacing="7">
                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Xác nhận mật khẩu mới" />

                    <PasswordField fx:id="txtXacNhanMatKhau" onAction="#onDoiMatKhau" prefHeight="45" promptText="Nhập lại mật khẩu mới" style="-fx-background-color: white;                                           -fx-background-radius: 13;                                           -fx-border-color: #E0E1E8;                                           -fx-border-radius: 13;                                           -fx-padding: 0 15;" />
                </VBox>

                <Label fx:id="lblThongBao" minHeight="25" style="-fx-font-size: 12px;" text="" wrapText="true" />

                <HBox spacing="10">
                    <Button fx:id="btnDoiMatKhau" onAction="#onDoiMatKhau" prefHeight="45" prefWidth="150" style="-fx-background-color: #5148C9;                                    -fx-background-radius: 13;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-font-size: 13px;" text="Đổi mật khẩu">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button fx:id="btnLamMoi" onAction="#onLamMoi" prefHeight="45" prefWidth="110" style="-fx-background-color: #E9EAF2;                                    -fx-background-radius: 13;                                    -fx-text-fill: #171A35;                                    -fx-font-weight: bold;                                    -fx-font-size: 13px;" text="Làm mới">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </HBox>

                <VBox.margin>
                    <Insets left="150.0" />
                </VBox.margin>

            </VBox>

        </VBox>
    </center>

</BorderPane>
