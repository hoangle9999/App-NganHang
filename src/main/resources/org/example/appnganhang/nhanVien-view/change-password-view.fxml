<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.ChangePasswordController"
            prefWidth="1100.0"
            prefHeight="750.0">

    <left>
        <VBox prefWidth="235.0"
              style="-fx-background-color: #171A35;">

            <padding>
                <Insets top="25" right="15" bottom="20" left="15"/>
            </padding>

            <!-- LOGO -->
            <VBox spacing="2">
                <Label text="SMART BANK"
                       style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

                <Label text="YOUR SMART BANKING"
                       style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 10px;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- USER -->
            <VBox spacing="3">
                <Label text="Xin chào"
                       style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 12px;"/>

                <Label text="Người dùng"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="MENU"
                   style="-fx-text-fill: #8F93AF;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets bottom="8"/>
                </VBox.margin>
            </Label>

            <!-- MENU -->
            <VBox spacing="5">

                <Button text="Khách hàng"
                        maxWidth="Infinity"
                        onAction="#onKhachHang"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Tài khoản"
                        maxWidth="Infinity"
                        onAction="#onTaiKhoan"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Chuyển tiền"
                        maxWidth="Infinity"
                        onAction="#onChuyenTien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Tra cứu giao dịch"
                        maxWidth="Infinity"
                        onAction="#onTraCuuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Lịch sử giao dịch"
                        maxWidth="Infinity"
                        onAction="#onLichSuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Hạn mức"
                        maxWidth="Infinity"
                        onAction="#onHanMuc"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Loại giao dịch"
                        maxWidth="Infinity"
                        onAction="#onLoaiGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Chi nhánh"
                        maxWidth="Infinity"
                        onAction="#onChiNhanh"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Nhân viên"
                        maxWidth="Infinity"
                        onAction="#onNhanVien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

                <Button text="Báo cáo"
                        maxWidth="Infinity"
                        onAction="#onBaoCao"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- BOTTOM MENU -->
            <VBox spacing="5">

                <!-- ĐỔI MẬT KHẨU - ACTIVE -->
                <Button text="Đổi mật khẩu"
                        maxWidth="Infinity"
                        onAction="#onDoiMatKhau"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-font-size: 13px;"/>

                <Button text="Đăng xuất"
                        maxWidth="Infinity"
                        onAction="#onDangXuat"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            </VBox>

        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <VBox spacing="20"
              style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- HEADER -->
            <VBox spacing="5">
                <Label text="Đổi mật khẩu"
                       style="-fx-text-fill: #171A35;
                              -fx-font-size: 26px;
                              -fx-font-weight: bold;"/>

                <Label text="Cập nhật mật khẩu đăng nhập của tài khoản"
                       style="-fx-text-fill: #777B91;
                              -fx-font-size: 13px;"/>
            </VBox>

            <!-- CARD -->
            <VBox maxWidth="650"
                  spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                <padding>
                    <Insets top="30" right="35" bottom="30" left="35"/>
                </padding>

                <Label text="Thông tin mật khẩu"
                       style="-fx-text-fill: #171A35;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <!-- MẬT KHẨU CŨ -->
                <VBox spacing="7">
                    <Label text="Mật khẩu hiện tại"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtMatKhauCu"
                                   promptText="Nhập mật khẩu hiện tại"
                                   prefHeight="45"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 13;
                                          -fx-border-color: #E0E1E8;
                                          -fx-border-radius: 13;
                                          -fx-padding: 0 15;"/>
                </VBox>

                <!-- MẬT KHẨU MỚI -->
                <VBox spacing="7">
                    <Label text="Mật khẩu mới"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtMatKhauMoi"
                                   promptText="Nhập mật khẩu mới"
                                   prefHeight="45"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 13;
                                          -fx-border-color: #E0E1E8;
                                          -fx-border-radius: 13;
                                          -fx-padding: 0 15;"/>
                </VBox>

                <!-- XÁC NHẬN -->
                <VBox spacing="7">
                    <Label text="Xác nhận mật khẩu mới"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtXacNhanMatKhau"
                                   promptText="Nhập lại mật khẩu mới"
                                   prefHeight="45"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 13;
                                          -fx-border-color: #E0E1E8;
                                          -fx-border-radius: 13;
                                          -fx-padding: 0 15;"/>
                </VBox>

                <!-- THÔNG BÁO -->
                <Label fx:id="lblThongBao"
                       text=""
                       minHeight="25"
                       wrapText="true"
                       style="-fx-font-size: 12px;"/>

                <!-- BUTTON -->
                <HBox spacing="10">

                    <Button fx:id="btnDoiMatKhau"
                            text="Đổi mật khẩu"
                            prefHeight="45"
                            prefWidth="150"
                            onAction="#onDoiMatKhau"
                            style="-fx-background-color: #5148C9;
                                   -fx-background-radius: 13;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 13px;"/>

                    <Button fx:id="btnLamMoi"
                            text="Làm mới"
                            prefHeight="45"
                            prefWidth="110"
                            onAction="#onLamMoi"
                            style="-fx-background-color: #E9EAF2;
                                   -fx-background-radius: 13;
                                   -fx-text-fill: #171A35;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 13px;"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>