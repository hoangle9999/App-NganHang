<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1280" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.nhanvien.DashboardController">

    <left>
        <VBox prefWidth="235"
              spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets bottom="20"
                        left="20"
                        right="15"
                        top="25" />
            </padding>

            <Label style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"
                   text="SMART BANK" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #BFC2D8;"
                   text="YOUR SMART BANKING" />

            <Region prefHeight="15" />

            <VBox spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;">

                <Label style="-fx-font-size: 11px;
                              -fx-text-fill: #BFC2D8;"
                       text="Xin chào" />

                <Label style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"
                       text="Người dùng" />

            </VBox>

            <Region prefHeight="10" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #8F93AF;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 5 5;"
                   text="MENU" />

            <VBox spacing="4"
                  VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTrangChu"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"
                        text="Trang chủ">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onKhachHang"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Khách hàng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChuyenTien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chuyển tiền">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTraCuuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Tra cứu giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLichSuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Lịch sử giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onHanMuc"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Hạn mức">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLoaiGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Loại giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChiNhanh"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chi nhánh">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onNhanVien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Nhân viên">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onBaoCao"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Báo cáo">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onDoiMatKhau"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Đổi mật khẩu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

            </VBox>

            <Button alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#onDangXuat"
                    style="-fx-background-color: transparent;
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"
                    text="Đăng xuất">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets bottom="35" left="40" right="40" top="35" />
            </padding>

            <VBox spacing="6">
                <Label style="-fx-text-fill: #171A35;                               -fx-font-size: 28px;                               -fx-font-weight: bold;" text="Tổng quan" />

                <Label style="-fx-text-fill: #777B91;                               -fx-font-size: 14px;" text="Chào mừng bạn đến với hệ thống SMART BANK" />
            </VBox>

            <VBox spacing="8" style="-fx-background-color: #5148C9;                          -fx-background-radius: 20;">

                <padding>
                    <Insets bottom="25" left="30" right="30" top="25" />
                </padding>

                <Label style="-fx-text-fill: white;                               -fx-font-size: 14px;                               -fx-font-weight: bold;" text="SMART BANK" />

                <Label style="-fx-text-fill: white;                               -fx-font-size: 24px;                               -fx-font-weight: bold;" text="Xin chào, Người dùng!" />

                <Label style="-fx-text-fill: #E7E6FF;                               -fx-font-size: 13px;" text="Quản lý tài khoản và giao dịch ngân hàng của bạn một cách nhanh chóng." wrapText="true" />
            </VBox>

            <VBox spacing="15">
                <Label style="-fx-text-fill: #171A35;                               -fx-font-size: 18px;                               -fx-font-weight: bold;" text="Truy cập nhanh" />

                <HBox spacing="15">
                    <Button onAction="#onChuyenTien" prefHeight="80" prefWidth="190" style="-fx-background-color: white;                                    -fx-background-radius: 18;                                    -fx-text-fill: #171A35;                                    -fx-font-size: 14px;                                    -fx-font-weight: bold;                                    -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" text="Chuyển tiền">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button onAction="#onLichSuGiaoDich" prefHeight="80" prefWidth="190" style="-fx-background-color: white;                                    -fx-background-radius: 18;                                    -fx-text-fill: #171A35;                                    -fx-font-size: 14px;                                    -fx-font-weight: bold;                                    -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" text="Lịch sử giao dịch">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button onAction="#onKhachHang" prefHeight="80" prefWidth="190" style="-fx-background-color: white;                                    -fx-background-radius: 18;                                    -fx-text-fill: #171A35;                                    -fx-font-size: 14px;                                    -fx-font-weight: bold;                                    -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" text="Khách hàng">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button onAction="#onBaoCao" prefHeight="80" prefWidth="190" style="-fx-background-color: white;                                    -fx-background-radius: 18;                                    -fx-text-fill: #171A35;                                    -fx-font-size: 14px;                                    -fx-font-weight: bold;                                    -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" text="Báo cáo">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </HBox>
            </VBox>

            <HBox spacing="15">
                <VBox spacing="8" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label fx:id="lblTitleCard1" style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Tổng khách hàng " />

                    <Label fx:id="lblValueCard1" style="-fx-text-fill: #171A35;                                   -fx-font-size: 20px;                                   -fx-font-weight: bold;" text="1903 8888 9999" />

                    <Label fx:id="lblSubCard1" style="-fx-text-fill: #2E8B57;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Đang hoạt động" />
                </VBox>

                <VBox spacing="8" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label fx:id="lblTitleCard2" style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Tổng số dư hệ thống" />

                    <Label fx:id="lblValueCard2" style="-fx-text-fill: #171A35;                                   -fx-font-size: 20px;                                   -fx-font-weight: bold;" text="15,450,000 VNĐ" />

                    <Label fx:id="lblSubCard2" style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Số dư khả dụng" />
                </VBox>

                <VBox spacing="8" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label fx:id="lblTitleCard3" style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Giao dịch hôm nay" />

                    <Label fx:id="lblValueCard3" style="-fx-text-fill: #171A35;                                   -fx-font-size: 20px;                                   -fx-font-weight: bold;" text="3 giao dịch" />

                    <Label fx:id="lblSubCard3" style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Giao dịch thành công" />
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>
