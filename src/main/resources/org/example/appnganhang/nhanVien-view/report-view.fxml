<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.nhanvien.BaoCaoController">

    <left>
        <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets bottom="20" left="20" right="15" top="25" />
            </padding>

            <Label style="-fx-font-size: 24px;                           -fx-font-weight: bold;                           -fx-text-fill: white;" text="SMART BANK" />

            <Label style="-fx-font-size: 10px;                           -fx-text-fill: #C9C9DD;" text="YOUR SMART BANKING" />

            <Region prefHeight="15" />

            <VBox spacing="4" style="-fx-background-color: rgba(255,255,255,0.08);                          -fx-background-radius: 12;                          -fx-padding: 12 15;">

                <Label style="-fx-font-size: 11px;                               -fx-text-fill: #BDBDD2;" text="Xin chào" />

                <Label style="-fx-font-size: 15px;                               -fx-font-weight: bold;                               -fx-text-fill: white;" text="Người dùng" />
            </VBox>

            <Region prefHeight="10" />

            <Label style="-fx-font-size: 10px;                           -fx-text-fill: #BDBDD2;                           -fx-padding: 0 0 5 5;" text="MENU" />

            <VBox spacing="4" VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTrangChu" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Trang chủ">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onKhachHang" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Khách hàng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onChuyenTien" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Chuyển tiền">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Tra cứu giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLichSuGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Lịch sử giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onHanMuc" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Hạn mức">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onLoaiGiaoDich" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Loại giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onChiNhanh" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Chi nhánh">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onNhanVien" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Nhân viên">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onBaoCao" style="-fx-background-color: rgba(255,255,255,0.15);                                -fx-background-radius: 10;                                -fx-text-fill: white;                                -fx-font-size: 13px;                                -fx-font-weight: bold;                                -fx-padding: 10 12;                                -fx-cursor: hand;" text="Báo cáo">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDoiMatKhau" style="-fx-background-color: transparent;                                -fx-text-fill: #D0D0E0;                                -fx-font-size: 13px;                                -fx-padding: 10 12;                                -fx-background-radius: 10;                                -fx-cursor: hand;" text="Đổi mật khẩu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>

            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent;                            -fx-background-radius: 10;                            -fx-text-fill: #D0D0E0;                            -fx-font-size: 13px;                            -fx-padding: 10 12;                            -fx-cursor: hand;" text="Đăng xuất">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
        </VBox>
    </left>

    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets bottom="30" left="35" right="35" top="30" />
            </padding>

            <top>
                <VBox spacing="5">

                    <Label style="-fx-font-size: 27px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #171A35;" text="Báo cáo" />

                    <Label style="-fx-font-size: 13px;                                   -fx-text-fill: #85879A;" text="Thống kê và theo dõi tình hình giao dịch của hệ thống" />
                </VBox>
            </top>

            <center>
                <VBox spacing="18">

                    <VBox spacing="15" style="-fx-background-color: white;                                  -fx-background-radius: 20;                                  -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                        <padding>
                            <Insets bottom="20" left="25" right="25" top="20" />
                        </padding>

                        <Label style="-fx-font-size: 16px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #171A35;" text="Bộ lọc báo cáo" />

                        <HBox spacing="15">

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #4B5563;" text="Từ ngày" />

                                <TextField fx:id="txtTuNgay" promptText="dd/MM/yyyy" style="-fx-background-color: white;                                                   -fx-background-radius: 13;                                                   -fx-border-color: #E0E1E8;                                                   -fx-border-radius: 13;                                                   -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #4B5563;" text="Đến ngày" />

                                <TextField fx:id="txtDenNgay" promptText="dd/MM/yyyy" style="-fx-background-color: white;                                                   -fx-background-radius: 13;                                                   -fx-border-color: #E0E1E8;                                                   -fx-border-radius: 13;                                                   -fx-padding: 10 15;" />
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 12px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #4B5563;" text="Loại báo cáo" />

                                <ComboBox fx:id="cboLoaiBaoCao" maxWidth="Infinity" promptText="Chọn loại báo cáo" style="-fx-background-color: white;                                                  -fx-background-radius: 13;                                                  -fx-border-color: #E0E1E8;                                                  -fx-border-radius: 13;" />
                            </VBox>
                        </HBox>

                        <HBox spacing="10">

                            <Button fx:id="btnThongKe" onAction="#onThongKe" prefHeight="40" prefWidth="110" style="-fx-background-color: #5148C9;                                            -fx-background-radius: 13;                                            -fx-text-fill: white;                                            -fx-font-weight: bold;                                            -fx-cursor: hand;" text="Thống kê">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnLamMoi" onAction="#onLamMoi" prefHeight="40" prefWidth="100" style="-fx-background-color: #F1F2F6;                                            -fx-background-radius: 13;                                            -fx-text-fill: #555A70;                                            -fx-font-weight: bold;                                            -fx-cursor: hand;" text="Làm mới">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>

                            <Button fx:id="btnXuatBaoCao" onAction="#onXuatBaoCao" prefHeight="40" prefWidth="120" style="-fx-background-color: #ECEBFA;                                            -fx-background-radius: 13;                                            -fx-text-fill: #5148C9;                                            -fx-font-weight: bold;                                            -fx-cursor: hand;" text="Xuất báo cáo">
                                <cursor>
                                    <Cursor fx:constant="HAND" />
                                </cursor>
                            </Button>
                        </HBox>
                    </VBox>

                    <HBox spacing="15">

                        <VBox spacing="5" style="-fx-background-color: white;                                      -fx-background-radius: 18;                                      -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="15" left="20" right="20" top="15" />
                            </padding>

                            <Label style="-fx-font-size: 12px;                                           -fx-text-fill: #85879A;" text="Tổng số giao dịch" />

                            <Label fx:id="lblTongSoGiaoDich" style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #171A35;" text="0" />
                        </VBox>

                        <VBox spacing="5" style="-fx-background-color: white;                                      -fx-background-radius: 18;                                      -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="15" left="20" right="20" top="15" />
                            </padding>

                            <Label style="-fx-font-size: 12px;                                           -fx-text-fill: #85879A;" text="Tổng tiền giao dịch" />

                            <Label fx:id="lblTongTien" style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #171A35;" text="0 VNĐ" />
                        </VBox>

                        <VBox spacing="5" style="-fx-background-color: white;                                      -fx-background-radius: 18;                                      -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="15" left="20" right="20" top="15" />
                            </padding>

                            <Label style="-fx-font-size: 12px;                                           -fx-text-fill: #85879A;" text="Giao dịch thành công" />

                            <Label fx:id="lblGiaoDichThanhCong" style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #2E8B57;" text="0" />
                        </VBox>

                        <VBox spacing="5" style="-fx-background-color: white;                                      -fx-background-radius: 18;                                      -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="15" left="20" right="20" top="15" />
                            </padding>

                            <Label style="-fx-font-size: 12px;                                           -fx-text-fill: #85879A;" text="Giao dịch thất bại" />

                            <Label fx:id="lblGiaoDichThatBai" style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #D9534F;" text="0" />
                        </VBox>
                    </HBox>

                    <VBox spacing="12" style="-fx-background-color: white;                                  -fx-background-radius: 20;                                  -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);" VBox.vgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label style="-fx-font-size: 16px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #171A35;" text="Chi tiết báo cáo" />

                        <TableView fx:id="tblBaoCao" VBox.vgrow="ALWAYS">

                            <columns>
                                <TableColumn fx:id="colMaGiaoDich" prefWidth="120" text="Mã giao dịch" />

                                <TableColumn fx:id="colTaiKhoanNguon" prefWidth="150" text="Số tài khoản nguồn" />

                                <TableColumn fx:id="colTaiKhoanDich" prefWidth="150" text="Số tài khoản đích" />

                                <TableColumn fx:id="colSoTien" prefWidth="181.60000610351562" text="Số tiền" />

                                <TableColumn fx:id="colNgayGiaoDich" prefWidth="169.3333740234375" text="Ngày giao dịch" />

                                <TableColumn fx:id="colTrangThai" prefWidth="162.6666259765625" text="Trạng thái" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
