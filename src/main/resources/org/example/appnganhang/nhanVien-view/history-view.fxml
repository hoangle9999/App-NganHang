<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760"
            prefWidth="1280"
            style="-fx-background-color: #F7F8FC;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.nhanvien.LichSuGiaoDichController">

    <left>
        <VBox prefWidth="235"
              spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets bottom="20" left="20" right="15" top="25" />
            </padding>

            <Label style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"
                   text="SMART BANK" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #C9C9DD;"
                   text="YOUR SMART BANKING" />

            <Region prefHeight="15" />

            <VBox spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;">

                <Label style="-fx-font-size: 11px;
                              -fx-text-fill: #BDBDD2;"
                       text="Xin chào" />

                <Label style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"
                       text="Người dùng" />
            </VBox>

            <Region prefHeight="10" />

            <Label style="-fx-font-size: 10px;
                          -fx-text-fill: #BDBDD2;
                          -fx-padding: 0 0 5 5;"
                   text="MENU" />

            <VBox spacing="4" VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTrangChu"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Trang chủ">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onKhachHang"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Khách hàng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChuyenTien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chuyển tiền">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onTraCuuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Tra cứu giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLichSuGiaoDich"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"
                        text="Lịch sử giao dịch" />

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onHanMuc"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Hạn mức">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onLoaiGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Loại giao dịch">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onChiNhanh"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Chi nhánh">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onNhanVien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Nhân viên">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onBaoCao"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Báo cáo">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <Button alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        onAction="#onDoiMatKhau"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        text="Đổi mật khẩu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>

            <Button alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#onDangXuat"
                    style="-fx-background-color: transparent;
                           -fx-background-radius: 10;
                           -fx-text-fill: #D0D0E0;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"
                    text="Đăng xuất">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
        </VBox>
    </left>

    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets bottom="30" left="35" right="35" top="30" />
            </padding>

            <top>
                <VBox spacing="5">

                    <Label style="-fx-font-size: 27px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #171A35;"
                           text="Lịch sử giao dịch" />

                    <Label style="-fx-font-size: 13px;
                                  -fx-text-fill: #85879A;"
                           text="Theo dõi lịch sử các giao dịch đã phát sinh trong hệ thống" />
                </VBox>
            </top>

            <center>
                <VBox spacing="18">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                        <padding>
                            <Insets bottom="18" left="22" right="22" top="18" />
                        </padding>

                        <Label style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #4B5563;"
                               text="Số tài khoản:" />

                        <TextField fx:id="txtMaTaiKhoan"
                                   onAction="#onTimKiem"
                                   prefWidth="260"
                                   promptText="Nhập số tài khoản"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 13;
                                          -fx-border-color: #E0E1E8;
                                          -fx-border-radius: 13;
                                          -fx-padding: 10 15;" />

                        <Button fx:id="btnTimKiem"
                                onAction="#onTimKiem"
                                prefHeight="40"
                                prefWidth="110"
                                style="-fx-background-color: #5148C9;
                                       -fx-background-radius: 13;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"
                                text="Tra cứu">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="btnLamMoi"
                                onAction="#onLamMoi"
                                prefHeight="40"
                                prefWidth="100"
                                style="-fx-background-color: #F1F2F6;
                                       -fx-background-radius: 13;
                                       -fx-text-fill: #555A70;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"
                                text="Làm mới">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </HBox>

                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);"
                          VBox.vgrow="ALWAYS">

                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <Label style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"
                               text="Danh sách lịch sử giao dịch" />

                        <TableView fx:id="tblLichSu" VBox.vgrow="ALWAYS">

                            <columns>
                                <TableColumn fx:id="colMaLog"
                                             prefWidth="80"
                                             text="Mã log" />

                                <TableColumn fx:id="colMaGD"
                                             prefWidth="111.20005226135254"
                                             text="Mã giao dịch" />

                                <TableColumn fx:id="colSoTaiKhoan"
                                             prefWidth="208.79994201660156"
                                             text="Số tài khoản liên quan" />

                                <TableColumn fx:id="colHanhDong"
                                             prefWidth="180"
                                             text="Hành động" />

                                <TableColumn fx:id="colSoTienThayDoi"
                                             prefWidth="160"
                                             text="Số tiền thay đổi" />

                                <TableColumn fx:id="colSoDuSauThayDoi"
                                             prefWidth="160"
                                             text="Số dư sau thay đổi" />

                                <TableColumn fx:id="colTrangThai"
                                             prefWidth="131.20013427734375"
                                             text="Trạng thái" />

                                <TableColumn fx:id="colThoiGianGhiLog"
                                             prefWidth="139.9998779296875"
                                             text="Thời gian ghi log" />
                            </columns>

                        </TableView>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
