<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.DashboardController"
            prefWidth="1100.0"
            prefHeight="750.0">

   <!-- ==================== SIDEBAR ==================== -->
   <left>
      <VBox prefWidth="235.0"
            style="-fx-background-color: #171A35;">

         <padding>
            <Insets top="25" right="15" bottom="20" left="15"/>
         </padding>

         <!-- LOGO -->
         <VBox spacing="2">
            <Label text="SMART BANK"
                   style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

            <Label text="YOUR SMART BANKING"
                   style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 10px;"/>
         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- USER -->
         <VBox spacing="3">
            <Label text="Xin chào"
                   style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 12px;"/>

            <Label text="Người dùng"
                   style="-fx-text-fill: white;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;"/>
         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <Label text="MENU"
                style="-fx-text-fill: #8F93AF;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;">
            <VBox.margin>
               <Insets bottom="8"/>
            </VBox.margin>
         </Label>

         <!-- MENU -->
         <VBox spacing="5">

            <!-- TRANG CHỦ -->
            <Button text="Trang chủ"
                    maxWidth="Infinity"
                    onAction="#handleTrangChu"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-font-size: 13px;"/>

            <Button text="Khách hàng"
                    maxWidth="Infinity"
                    onAction="#onKhachHang"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Tài khoản"
                    maxWidth="Infinity"
                    onAction="#onTaiKhoan"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Chuyển tiền"
                    maxWidth="Infinity"
                    onAction="#onChuyenTien"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Tra cứu giao dịch"
                    maxWidth="Infinity"
                    onAction="#onTraCuuGiaoDich"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Lịch sử giao dịch"
                    maxWidth="Infinity"
                    onAction="#onLichSuGiaoDich"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Hạn mức"
                    maxWidth="Infinity"
                    onAction="#onHanMuc"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Loại giao dịch"
                    maxWidth="Infinity"
                    onAction="#onLoaiGiaoDich"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Chi nhánh"
                    maxWidth="Infinity"
                    onAction="#onChiNhanh"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Nhân viên"
                    maxWidth="Infinity"
                    onAction="#onNhanVien"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Báo cáo"
                    maxWidth="Infinity"
                    onAction="#onBaoCao"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- BOTTOM MENU -->
         <VBox spacing="5">

            <Button text="Đổi mật khẩu"
                    maxWidth="Infinity"
                    onAction="#onDoiMatKhau"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

            <Button text="Đăng xuất"
                    maxWidth="Infinity"
                    onAction="#onDangXuat"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-font-size: 13px;"/>

         </VBox>

      </VBox>
   </left>

   <!-- ==================== CONTENT ==================== -->
   <center>

      <VBox spacing="25"
            style="-fx-background-color: #F7F8FC;">

         <padding>
            <Insets top="35" right="40" bottom="35" left="40"/>
         </padding>

         <!-- HEADER -->
         <VBox spacing="6">

            <Label text="Tổng quan"
                   style="-fx-text-fill: #171A35;
                              -fx-font-size: 28px;
                              -fx-font-weight: bold;"/>

            <Label text="Chào mừng bạn đến với hệ thống SMART BANK"
                   style="-fx-text-fill: #777B91;
                              -fx-font-size: 14px;"/>

         </VBox>

         <!-- ==================== WELCOME CARD ==================== -->
         <VBox spacing="8"
               style="-fx-background-color: #5148C9;
                         -fx-background-radius: 20;">

            <padding>
               <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <Label text="SMART BANK"
                   style="-fx-text-fill: white;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;"/>

            <Label text="Xin chào, Người dùng!"
                   style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

            <Label text="Quản lý tài khoản và giao dịch ngân hàng của bạn một cách nhanh chóng."
                   wrapText="true"
                   style="-fx-text-fill: #E7E6FF;
                              -fx-font-size: 13px;"/>

         </VBox>

         <!-- ==================== QUICK ACTION ==================== -->
         <VBox spacing="15">

            <Label text="Truy cập nhanh"
                   style="-fx-text-fill: #171A35;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

            <HBox spacing="15">

               <Button text="Chuyển tiền"
                       prefWidth="190"
                       prefHeight="80"
                       onAction="#handleChuyenTien"
                       style="-fx-background-color: white;
                                   -fx-background-radius: 18;
                                   -fx-text-fill: #171A35;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);"/>

               <Button text="Lịch sử giao dịch"
                       prefWidth="190"
                       prefHeight="80"
                       onAction="#handleLichSu"
                       style="-fx-background-color: white;
                                   -fx-background-radius: 18;
                                   -fx-text-fill: #171A35;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);"/>

               <Button text="Khách hàng"
                       prefWidth="190"
                       prefHeight="80"
                       onAction="#onKhachHang"
                       style="-fx-background-color: white;
                                   -fx-background-radius: 18;
                                   -fx-text-fill: #171A35;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);"/>

               <Button text="Báo cáo"
                       prefWidth="190"
                       prefHeight="80"
                       onAction="#onBaoCao"
                       style="-fx-background-color: white;
                                   -fx-background-radius: 18;
                                   -fx-text-fill: #171A35;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);"/>

            </HBox>

         </VBox>

         <!-- ==================== INFORMATION ==================== -->
         <HBox spacing="15">

            <VBox spacing="8"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);">

               <padding>
                  <Insets top="20" right="20" bottom="20" left="20"/>
               </padding>

               <Label text="Tài khoản"
                      style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

               <Label text="1903 8888 9999"
                      style="-fx-text-fill: #171A35;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

               <Label text="Đang hoạt động"
                      style="-fx-text-fill: #2E8B57;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

            </VBox>

            <VBox spacing="8"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);">

               <padding>
                  <Insets top="20" right="20" bottom="20" left="20"/>
               </padding>

               <Label text="Số dư hiện tại"
                      style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

               <Label text="15,450,000 VNĐ"
                      style="-fx-text-fill: #171A35;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

               <Label text="Số dư khả dụng"
                      style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

            </VBox>

            <VBox spacing="8"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 15, 0.15, 0, 4);">

               <padding>
                  <Insets top="20" right="20" bottom="20" left="20"/>
               </padding>

               <Label text="Giao dịch gần đây"
                      style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

               <Label text="3 giao dịch"
                      style="-fx-text-fill: #171A35;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

               <Label text="Trong ngày hôm nay"
                      style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

            </VBox>

         </HBox>

      </VBox>

   </center>

</BorderPane>