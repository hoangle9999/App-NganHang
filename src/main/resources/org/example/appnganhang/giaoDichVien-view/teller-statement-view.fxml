                            </children>
                        </VBox>

                        <!-- CHỮ KÝ VÀ DẤU MỘC SAO KÊ -->
                        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15 0 10 0;">
                            <children>
                                <VBox alignment="CENTER" spacing="35.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="NGƯỜI YÊU CẦU SAO KÊ" />
                                        <Label style="-fx-font-size: 11px; -fx-font-style: italic; -fx-text-fill: #94A3B8;" text="(Ký, ghi rõ họ tên)" />
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER" spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="GIAO DỊCH VIÊN LẬP BIỂU" />
                                        <Label fx:id="lblPrintTeller" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="Nguyễn Văn A" />
                                        <Label style="-fx-font-size: 10px; -fx-text-fill: #10B981; -fx-border-color: #10B981; -fx-border-radius: 6; -fx-padding: 2 6;" text="✔ ĐÃ ĐỐI CHIẾU SỐ DƯ" />
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #DC2626;" text="DẤU MỘC NGÂN HÀNG" />
                                        <Label style="-fx-border-color: #DC2626; -fx-border-width: 2; -fx-border-radius: 40; -fx-padding: 8 16; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-font-size: 11px;" text="SMART BANK ★ ĐÃ XÁC THỰC" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- NÚT TÁC VỤ IN -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button onAction="#onDongModalInSaoKe" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 12; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Đóng">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                                <Button onAction="#onInSaoKeThucTe" prefHeight="38.0" prefWidth="160.0" style="-fx-background-color: #5148C9; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🖨 Xác nhận in biểu">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
