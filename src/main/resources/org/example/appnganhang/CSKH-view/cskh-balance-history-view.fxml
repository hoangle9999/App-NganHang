<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.cskh.CSKHBalanceHistoryController">

    <!-- MAIN VIEW -->
    <BorderPane fx:id="mainPane" prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;">

        <!-- LEFT SIDEBAR -->
        <left>
            <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">
                <padding>
                    <Insets bottom="20" left="20" right="15" top="25" />
                </padding>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="SMART BANK" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #C9C9DD;" text="HỆ THỐNG CHĂM SÓC KHÁCH HÀNG" />

                <Region prefHeight="15" />

                <!-- User Profile Badge -->
                <VBox spacing="4" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-padding: 12 15;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #BDBDD2;" text="Xin chào" />
                    <Label fx:id="lblStaffName" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nhân viên CSKH" />
                </VBox>

                <Region prefHeight="10" />

                <Label style="-fx-font-size: 10px; -fx-text-fill: #BDBDD2; -fx-padding: 0 0 5 5;" text="CHỨC NĂNG CSKH" />

                <!-- Sidebar Nav Buttons -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDashboard" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tổng quan CSKH">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onKhachHang" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Quản lý khách hàng">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuTaiKhoan" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tra cứu tài khoản">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTraCuuGiaoDich" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tra cứu giao dịch">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <!-- Active Button: Đối soát & Biến động -->
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDoiSoatBienDong" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12; -fx-cursor: hand;" text="Đối soát &amp; Biến động">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </VBox>

                <!-- Logout Button -->
                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;" text="Đăng xuất">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <BorderPane style="-fx-background-color: #F7F8FC;">
                <padding>
                    <Insets bottom="30" left="35" right="35" top="30" />
                </padding>

                <!-- PAGE HEADER -->
                <top>
                    <VBox spacing="5">
                        <padding>
                            <Insets bottom="18" />
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Đối soát &amp; Lịch sử Biến động Số dư" />
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 8; -fx-padding: 3 8;" text="CHẾ ĐỘ CHỈ XEM" />
                        </HBox>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #85879A;" text="Tra cứu nhật ký ghi nhận biến động tiền tệ phục vụ đối soát và giải quyết khiếu nại sai lệch số dư" />
                    </VBox>
                </top>

                <!-- CENTER BODY -->
                <center>
                    <VBox spacing="18">

                        <!-- SEARCH CARD -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">
                            <padding>
                                <Insets bottom="20" left="25" right="25" top="20" />
                            </padding>

                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Khung tìm kiếm đối soát" />

                            <HBox alignment="BOTTOM_LEFT" spacing="15">
                                <!-- Search Input -->
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Số tài khoản liên quan hoặc Mã giao dịch" />
                                    <TextField fx:id="txtTimKiemLog" onAction="#onTraCuuLog" prefHeight="40" promptText="Số tài khoản liên quan, mã giao dịch..." style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                                </VBox>

                                <!-- From Date -->
                                <VBox prefWidth="180" spacing="6">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Từ ngày" />
                                    <DatePicker fx:id="dpLogTuNgay" maxWidth="Infinity" prefHeight="40" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13;" />
                                </VBox>

                                <!-- To Date -->
                                <VBox prefWidth="180" spacing="6">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Đến ngày" />
                                    <DatePicker fx:id="dpLogDenNgay" maxWidth="Infinity" prefHeight="40" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13;" />
                                </VBox>

                                <!-- Action Buttons -->
                                <HBox spacing="10">
                                    <Button fx:id="btnTraCuuLog" onAction="#onTraCuuLog" prefHeight="40" prefWidth="150" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tra cứu nhật ký">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Button>

                                    <Button fx:id="btnLamMoi" onAction="#onLamMoi" prefHeight="40" prefWidth="95" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Làm mới">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Button>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- DATA TABLE CARD -->
                        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Nhật ký biến động số dư" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTongLog" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-padding: 4 10;" text="Tổng: 0 bản ghi" />
                            </HBox>

                            <TableView fx:id="tblBienDong" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colMaLog" prefWidth="80" text="Mã Log" />
                                    <TableColumn fx:id="colMaGD" prefWidth="120" text="Mã giao dịch" />
                                    <TableColumn fx:id="colSoTKLienQuan" prefWidth="150" text="Số TK liên quan" />
                                    <TableColumn fx:id="colHanhDong" prefWidth="140" text="Hành động" />
                                    <TableColumn fx:id="colSoTienThayDoi" prefWidth="150" text="Số tiền thay đổi" />
                                    <TableColumn fx:id="colSoDuSau" prefWidth="160" text="Số dư sau thay đổi" />
                                    <TableColumn fx:id="colThoiGian" prefWidth="170" text="Thời gian ghi log" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <!-- Bottom Action Bar -->
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button fx:id="btnInPhieuDoiSoat" onAction="#onMoModalInPhieuDoiSoat" prefHeight="40" prefWidth="220" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📋 In phiếu đối soát khiếu nại">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                                <Button onAction="#onLamMoi" prefHeight="40" prefWidth="95" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Làm mới">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </HBox>
                        </VBox>

                    </VBox>
                </center>

            </BorderPane>
        </center>
    </BorderPane>

    <!-- ======================================================== -->
    <!-- MODAL: PHIẾU ĐỐI SOÁT BIẾN ĐỘNG SỐ DƯ                   -->
    <!-- ======================================================== -->
    <StackPane fx:id="modalInPhieuDoiSoat" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
        <VBox alignment="TOP_CENTER" maxWidth="680" spacing="14" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0.2, 0, 10);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <!-- Bank Header -->
            <VBox alignment="CENTER" spacing="3">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="SMART BANK" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748B;" text="NGÂN HÀNG THƯƠNG MẠI CỔ PHẦN SMART BANK VIỆT NAM" />
                <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35; -fx-padding: 8 0 0 0;" text="PHIẾU ĐỐI SOÁT BIẾN ĐỘNG SỐ DƯ" />
                <Label fx:id="lblPrintNgayIn" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Ngày in: --/--/----" />
            </VBox>

            <!-- Customer Info Section -->
            <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-background-radius: 14; -fx-padding: 16;">
                <HBox spacing="20">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Số tài khoản liên quan" />
                        <Label fx:id="lblPrintSoTK" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="---" />
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Tên chủ tài khoản" />
                        <Label fx:id="lblPrintTenChuTK" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="---" />
                    </VBox>
                </HBox>
                <HBox spacing="20">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Mã giao dịch tham chiếu" />
                        <Label fx:id="lblPrintMaGD" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="---" />
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Ngày tra cứu" />
                        <Label fx:id="lblPrintNgayTraCuu" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="---" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Mini Table for Log Entries -->
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Chi tiết biến động" />

            <TableView fx:id="tblPrintBienDong" prefHeight="160">
                <columns>
                    <TableColumn fx:id="colPrintMaLog" prefWidth="70" text="Mã Log" />
                    <TableColumn fx:id="colPrintHanhDong" prefWidth="130" text="Hành động" />
                    <TableColumn fx:id="colPrintSoTienThayDoi" prefWidth="140" text="Số tiền thay đổi" />
                    <TableColumn fx:id="colPrintSoDuSau" prefWidth="140" text="Số dư sau GD" />
                    <TableColumn fx:id="colPrintThoiGian" prefWidth="150" text="Thời gian" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Signature Block -->
            <HBox spacing="30" style="-fx-padding: 14 0 0 0;">
                <VBox alignment="CENTER" spacing="45" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="KHÁCH HÀNG YÊU CẦU" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="(Ký, ghi rõ họ tên)" />
                </VBox>
                <VBox alignment="CENTER" spacing="45" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="NHÂN VIÊN CSKH XÁC NHẬN" />
                    <Label fx:id="lblPrintNguoiLap" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="(Xác nhận điện tử)" />
                </VBox>
            </HBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#onXacNhanInPhieuDoiSoat" prefHeight="40" prefWidth="150" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🖨 In phiếu (PDF)">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Button onAction="#onDongModalInPhieuDoiSoat" prefHeight="40" prefWidth="105" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Đóng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
