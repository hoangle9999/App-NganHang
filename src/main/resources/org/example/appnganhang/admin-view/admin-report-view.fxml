<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.admin.AdminReportController">

    <!-- MAIN PANE -->
    <BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;">

        <!-- LEFT SIDEBAR -->
        <left>
            <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">
                <padding>
                    <Insets bottom="20" left="20" right="15" top="25" />
                </padding>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="SMART BANK" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #C9C9DD;" text="HỆ THỐNG QUẢN TRỊ ADMIN" />

                <Region prefHeight="15" />

                <!-- User Profile Badge -->
                <VBox spacing="4" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-padding: 12 15;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #BDBDD2;" text="Xin chào" />
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Quản trị viên" />
                </VBox>

                <Region prefHeight="10" />

                <Label style="-fx-font-size: 10px; -fx-text-fill: #BDBDD2; -fx-padding: 0 0 5 5;" text="DANH MỤC QUẢN TRỊ" />

                <!-- Sidebar Nav Buttons -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTaiKhoan" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tài khoản &amp; Phân quyền">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onNhanVienChiNhanh" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Nhân viên &amp; Chi nhánh">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onCauHinhDanhMuc" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Cấu hình hệ thống">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <!-- Active Button -->
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onThongKeBaoCao" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12; -fx-cursor: hand;" text="Báo cáo &amp; Rủi ro">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </VBox>

                <!-- Logout Button -->
                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;" text="Đăng xuất">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <BorderPane style="-fx-background-color: #F7F8FC;">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="25" />
                </padding>

                <!-- PAGE HEADER -->
                <top>
                    <VBox spacing="4">
                        <padding>
                            <Insets bottom="14" />
                        </padding>
                        <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Thống kê, Báo cáo &amp; Phân tích Rủi ro" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #85879A;" text="Kiểm toán hệ thống, giám sát toàn diện giao dịch chuyển tiền và phân tích rủi ro (Chỉ xem - Read-Only)" />
                    </VBox>
                </top>

                <!-- CENTER BODY -->
                <center>
                    <VBox spacing="15">

                        <!-- 1. ADVANCED FILTER BAR -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">
                            <padding>
                                <Insets bottom="16" left="22" right="22" top="16" />
                            </padding>

                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Bộ lọc kiểm toán nâng cao" />

                            <HBox spacing="12">
                                <!-- Date Range -->
                                <VBox prefWidth="150" spacing="5">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Từ ngày" />
                                    <TextField fx:id="txtTuNgay" prefHeight="40" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 14;" />
                                </VBox>

                                <VBox prefWidth="150" spacing="5">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Đến ngày" />
                                    <TextField fx:id="txtDenNgay" prefHeight="40" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 14;" />
                                </VBox>

                                <!-- Transaction Type -->
                                <VBox prefWidth="180" spacing="5">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Loại giao dịch" />
                                    <ComboBox fx:id="cboLoaiGiaoDich" maxWidth="Infinity" prefHeight="40" promptText="Tất cả loại GD" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 5 10;" />
                                </VBox>

                                <!-- Bank -->
                                <VBox prefWidth="180" spacing="5">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Ngân hàng" />
                                    <ComboBox fx:id="cboNganHang" maxWidth="Infinity" prefHeight="40" promptText="Tất cả ngân hàng" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 5 10;" />
                                </VBox>

                                <!-- Search Code or Account -->
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Mã GD / Số tài khoản" />
                                    <TextField fx:id="txtTimKiemGD" onAction="#onLocDuLieu" prefHeight="40" promptText="Nhập Mã GD hoặc STK..." style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 14;" />
                                </VBox>
                            </HBox>

                            <!-- Filter Action Buttons -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button fx:id="btnLocDuLieu" onAction="#onLocDuLieu" prefHeight="40" prefWidth="120" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Lọc dữ liệu">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>

                                <Button fx:id="btnXuatExcel" onAction="#onXuatExcel" prefHeight="40" prefWidth="120" style="-fx-background-color: #ECEBFA; -fx-background-radius: 13; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-cursor: hand;" text="Xuất Excel">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>

                                <Button fx:id="btnInBaoCao" onAction="#onInBaoCao" prefHeight="40" prefWidth="110" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="In báo cáo">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>

                                <Button fx:id="btnLamMoi" onAction="#onLamMoi" prefHeight="40" prefWidth="95" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Làm mới">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </HBox>
                        </VBox>

                        <!-- 2. SUMMARY METRIC CARDS -->
                        <HBox spacing="15">
                            <!-- Card 1: Tổng số giao dịch -->
                            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4); -fx-padding: 16 20;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Tổng số lượng giao dịch" />
                                <Label fx:id="lblTongSoGiaoDich" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="0" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #10B981;" text="✓ Đã cập nhật theo bộ lọc" />
                            </VBox>

                            <!-- Card 2: Tổng giá trị giao dịch -->
                            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4); -fx-padding: 16 20;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Tổng giá trị giao dịch (VNĐ)" />
                                <Label fx:id="lblTongGiaTriGD" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="0 VNĐ" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Toàn bộ dòng tiền lưu thông" />
                            </VBox>

                            <!-- Card 3: Thất bại / Nghi vấn -->
                            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4); -fx-padding: 16 20;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Số giao dịch thất bại / nghi vấn" />
                                <Label fx:id="lblSoGDNghiVan" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D9534F;" text="0" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #D97706;" text="⚠ Cần kiểm soát rủi ro" />
                            </VBox>
                        </HBox>

                        <!-- 3. TABS: GIAO DỊCH & AUDIT LOG -->
                        <TabPane fx:id="tabPaneReport" style="-fx-tab-min-width: 200px; -fx-tab-max-height: 38px;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                            <tabs>

                                <!-- TAB 1: LỊCH SỬ GIAO DỊCH CHUYỂN TIỀN -->
                                <Tab text="Lịch Sử Giao Dịch Chuyển Tiền">
                                    <VBox spacing="10">
                                        <padding>
                                            <Insets top="12" />
                                        </padding>

                                        <TableView fx:id="tblGiaoDich" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMaGD" prefWidth="130" text="Mã GD" />
                                                <TableColumn fx:id="colTKNguon" prefWidth="130" text="TK Nguồn" />
                                                <TableColumn fx:id="colTKDich" prefWidth="130" text="TK Đích" />
                                                <TableColumn fx:id="colSoTien" prefWidth="150" text="Số tiền (VNĐ)" />
                                                <TableColumn fx:id="colNgayGD" prefWidth="160" text="Ngày GD" />
                                                <TableColumn fx:id="colLoaiGD" prefWidth="120" text="Loại GD" />
                                                <TableColumn fx:id="colTrangThaiGD" prefWidth="130" text="Trạng thái" />
                                                <TableColumn fx:id="colThaoTacGD" prefWidth="130" text="Thao tác" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <HBox alignment="CENTER_RIGHT" spacing="10">
                                            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Xem chi tiết giao dịch được chọn:" />
                                            <Button onAction="#onXemChiTietGiaoDich" prefHeight="35" prefWidth="140" style="-fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-cursor: hand;" text="Xem chi tiết">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                        </HBox>
                                    </VBox>
                                </Tab>

                                <!-- TAB 2: NHẬT KÝ KIỂM TOÁN (AUDIT LOG - READ ONLY) -->
                                <Tab text="Nhật Ký Kiểm Toán">
                                    <VBox spacing="10">
                                        <padding>
                                            <Insets top="12" />
                                        </padding>

                                        <TableView fx:id="tblAuditLog" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMaLog" prefWidth="90" text="Mã Log" />
                                                <TableColumn fx:id="colMaGDAudit" prefWidth="130" text="Mã GD" />
                                                <TableColumn fx:id="colSTKAudit" prefWidth="140" text="STK Liên quan" />
                                                <TableColumn fx:id="colHanhDongAudit" prefWidth="180" text="Hành động" />
                                                <TableColumn fx:id="colBienDongAudit" prefWidth="150" text="Biến động số dư" />
                                                <TableColumn fx:id="colSoDuSauAudit" prefWidth="160" text="Số dư sau thay đổi" />
                                                <TableColumn fx:id="colThoiGianAudit" prefWidth="170" text="Thời gian ghi log" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <HBox alignment="CENTER_LEFT">
                                            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A; -fx-font-style: italic;" text="* Dữ liệu nhật ký kiểm toán hệ thống được lưu vết tự động và không thể chỉnh sửa hoặc xóa." />
                                        </HBox>
                                    </VBox>
                                </Tab>

                            </tabs>
                        </TabPane>

                    </VBox>
                </center>
            </BorderPane>
        </center>
    </BorderPane>

    <!-- ======================================================== -->
    <!-- MODAL POPUP: CHI TIẾT GIAO DỊCH                          -->
    <!-- ======================================================== -->
    <StackPane fx:id="modalChiTietGD" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
        <VBox alignment="TOP_CENTER" maxWidth="560" spacing="16" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0.2, 0, 10);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Chi tiết giao dịch chuyển tiền" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblModalTrangThaiGD" style="-fx-background-color: #E8F8F0; -fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 4 10;" text="Thành công" />
            </HBox>

            <GridPane hgap="20" style="-fx-background-color: #F7F8FC; -fx-background-radius: 14; -fx-padding: 16 20;" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" />
                    <ColumnConstraints percentWidth="50.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>

                <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Mã giao dịch" />
                    <Label fx:id="lblModalMaGD" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="GD20261017001" />
                </VBox>

                <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Số tiền chuyển" />
                    <Label fx:id="lblModalSoTien" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="5,000,000 VNĐ" />
                </VBox>

                <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Tài khoản nguồn" />
                    <Label fx:id="lblModalTKNguon" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="1000000001" />
                </VBox>

                <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Tài khoản đích / Ngân hàng" />
                    <Label fx:id="lblModalTKDich" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="1000000002 (SMART BANK)" />
                </VBox>

                <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Thời gian thực hiện" />
                    <Label fx:id="lblModalThoiGian" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="17/10/2026 10:30:15" />
                </VBox>

                <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Loại giao dịch" />
                    <Label fx:id="lblModalLoaiGD" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Chuyển khoản nội bộ" />
                </VBox>

                <VBox spacing="3" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="Nội dung chuyển tiền chi tiết" />
                    <Label fx:id="lblModalNoiDung" style="-fx-font-size: 13px; -fx-text-fill: #171A35;" text="Nguyen Van A chuyen tien hoc phi" wrapText="true" />
                </VBox>
            </GridPane>

            <!-- Error code / failure reason if any -->
            <VBox fx:id="boxModalMaLoi" spacing="3" style="-fx-background-color: #FDECEC; -fx-background-radius: 10; -fx-padding: 10 15;">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #D9534F;" text="Mã lỗi hệ thống / Nguyên nhân thất bại:" />
                <Label fx:id="lblModalMaLoi" style="-fx-font-size: 13px; -fx-text-fill: #D9534F;" text="ERR_INSUFFICIENT_FUNDS: Số dư không đủ thực hiện giao dịch." wrapText="true" />
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button onAction="#onDongPopupChiTietGD" prefHeight="40" prefWidth="100" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đóng">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
