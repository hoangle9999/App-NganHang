<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.admin.AdminEmployeeBranchController">

    <!-- MAIN PANE -->
    <BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;">

        <!-- LEFT SIDEBAR -->
        <left>
            <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">
                <padding>
                    <Insets bottom="20" left="20" right="15" top="25" />
                </padding>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="SMART BANK" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #C9C9DD;" text="HỆ THỐNG QUẢN TRỊ ADMIN" />

                <Region prefHeight="15" />

                <!-- User Profile Badge -->
                <VBox spacing="4" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-padding: 12 15;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #BDBDD2;" text="Xin chào" />
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Quản trị viên" />
                </VBox>

                <Region prefHeight="10" />

                <Label style="-fx-font-size: 10px; -fx-text-fill: #BDBDD2; -fx-padding: 0 0 5 5;" text="DANH MỤC QUẢN TRỊ" />

                <!-- Sidebar Nav Buttons -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
               <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTrangChu" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tổng quan Admin">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </Button>
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTaiKhoan" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Tài khoản &amp; Phân quyền">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <!-- Active Button -->
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onNhanVienChiNhanh" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12; -fx-cursor: hand;" text="Nhân viên &amp; Chi nhánh">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onCauHinhDanhMuc" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Cấu hình hệ thống">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onThongKeBaoCao" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Báo cáo &amp; Rủi ro">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </VBox>

                <!-- Logout Button -->
                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;" text="Đăng xuất">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <BorderPane style="-fx-background-color: #F7F8FC;">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="25" />
                </padding>

                <!-- PAGE HEADER -->
                <top>
                    <VBox spacing="4">
                        <padding>
                            <Insets bottom="15" />
                        </padding>
                        <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Quản lý Nhân viên &amp; Chi nhánh" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #85879A;" text="Quản lý danh sách nhân sự, phân bổ chi nhánh công tác và liên kết tài khoản hệ thống" />
                    </VBox>
                </top>

                <!-- CENTER TABPANE -->
                <center>
                    <TabPane fx:id="tabPaneMain" style="-fx-tab-min-width: 180px; -fx-tab-max-height: 40px;" tabClosingPolicy="UNAVAILABLE">
                        <tabs>

                            <!-- ============================================== -->
                            <!-- TAB 1: QUẢN LÝ NHÂN VIÊN                       -->
                            <!-- ============================================== -->
                            <Tab text="Quản lý Nhân viên">
                                <VBox spacing="15">
                                    <padding>
                                        <Insets top="15" />
                                    </padding>

                                    <!-- Filter Bar & Action Card -->
                                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">
                                        <padding>
                                            <Insets bottom="18" left="22" right="22" top="18" />
                                        </padding>

                                        <HBox alignment="BOTTOM_LEFT" spacing="15">
                                            <!-- Search by name/phone/id -->
                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Tìm kiếm nhân viên" />
                                                <TextField fx:id="txtTimKiemNV" onAction="#onTimKiemNV" prefHeight="40" promptText="Tìm theo Họ tên / SĐT / Mã NV..." style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                                            </VBox>

                                            <!-- Dropdown Filter Branch -->
                                            <VBox prefWidth="230" spacing="6">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Chi nhánh" />
                                                <ComboBox fx:id="cboLocChiNhanhNV" maxWidth="Infinity" prefHeight="40" promptText="Tất cả chi nhánh" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 5 10;" />
                                            </VBox>

                                            <!-- Filter Buttons -->
                                            <HBox spacing="10">
                                                <Button fx:id="btnTimKiemNV" onAction="#onTimKiemNV" prefHeight="40" prefWidth="100" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tìm kiếm">
                                                    <cursor>
                                                        <Cursor fx:constant="HAND" />
                                                    </cursor>
                                                </Button>

                                                <Button fx:id="btnLamMoiNV" onAction="#onLamMoiNV" prefHeight="40" prefWidth="95" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Làm mới">
                                                    <cursor>
                                                        <Cursor fx:constant="HAND" />
                                                    </cursor>
                                                </Button>
                                            </HBox>

                                            <Region HBox.hgrow="ALWAYS" />

                                            <!-- Add New Employee Button -->
                                            <Button fx:id="btnThemNV" onAction="#onMoPopupThemNV" prefHeight="40" prefWidth="180" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Thêm nhân viên mới">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                        </HBox>
                                    </VBox>

                                    <!-- Table Employee Card -->
                                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);" VBox.vgrow="ALWAYS">
                                        <padding>
                                            <Insets bottom="18" left="20" right="20" top="18" />
                                        </padding>

                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Danh sách nhân viên ngân hàng" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblTongNV" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-padding: 4 10;" text="Tổng số: 0 nhân viên" />
                                        </HBox>

                                        <TableView fx:id="tblNhanVien" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMaNV" prefWidth="100" text="Mã NV" />
                                                <TableColumn fx:id="colHoTenNV" prefWidth="180" text="Họ tên" />
                                                <TableColumn fx:id="colSoDienThoaiNV" prefWidth="125" text="Số điện thoại" />
                                                <TableColumn fx:id="colChucVuNV" prefWidth="130" text="Chức vụ" />
                                                <TableColumn fx:id="colChiNhanhNV" prefWidth="160" text="Chi nhánh" />
                                                <TableColumn fx:id="colTaiKhoanLienKet" prefWidth="180" text="Tài khoản liên kết" />
                                                <TableColumn fx:id="colThaoTacNV" prefWidth="250" text="Thao tác" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <!-- Row Actions Bar -->
                                        <HBox alignment="CENTER_RIGHT" spacing="10">
                                            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Thao tác nhân viên đã chọn:" />
                                            <Button onAction="#onMoPopupLienKetTK" prefHeight="35" prefWidth="160" style="-fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-cursor: hand;" text="Cấp/Liên kết tài khoản">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                            <Button onAction="#onMoPopupSuaNV" prefHeight="35" prefWidth="110" style="-fx-background-color: #F1F2F6; -fx-background-radius: 10; -fx-text-fill: #171A35; -fx-font-weight: bold; -fx-cursor: hand;" text="Chỉnh sửa">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                            <Button onAction="#onMoPopupXoaNV" prefHeight="35" prefWidth="90" style="-fx-background-color: #FDECEC; -fx-background-radius: 10; -fx-text-fill: #D9534F; -fx-font-weight: bold; -fx-cursor: hand;" text="Xóa">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </Tab>

                            <!-- ============================================== -->
                            <!-- TAB 2: QUẢN LÝ CHI NHÁNH                       -->
                            <!-- ============================================== -->
                            <Tab text="Quản lý Chi nhánh">
                                <VBox spacing="15">
                                    <padding>
                                        <Insets top="15" />
                                    </padding>

                                    <!-- Action Bar Card -->
                                    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">
                                        <padding>
                                            <Insets bottom="18" left="22" right="22" top="18" />
                                        </padding>

                                        <HBox alignment="BOTTOM_LEFT" spacing="15">
                                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Tìm kiếm chi nhánh" />
                                                <TextField fx:id="txtTimKiemCN" onAction="#onTimKiemCN" prefHeight="40" promptText="Tìm theo Mã hoặc Tên chi nhánh..." style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                                            </VBox>

                                            <Button onAction="#onTimKiemCN" prefHeight="40" prefWidth="100" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tìm kiếm">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>

                                            <Button onAction="#onLamMoiCN" prefHeight="40" prefWidth="95" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Làm mới">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>

                                            <Region HBox.hgrow="ALWAYS" />

                                            <Button fx:id="btnThemChiNhanh" onAction="#onMoPopupThemCN" prefHeight="40" prefWidth="170" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Thêm chi nhánh">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                        </HBox>
                                    </VBox>

                                    <!-- Table Branch Card -->
                                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);" VBox.vgrow="ALWAYS">
                                        <padding>
                                            <Insets bottom="18" left="20" right="20" top="18" />
                                        </padding>

                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Danh sách các chi nhánh ngân hàng" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblTongCN" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-padding: 4 10;" text="Tổng số: 0 chi nhánh" />
                                        </HBox>

                                        <TableView fx:id="tblChiNhanh" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMaCN" prefWidth="150" text="Mã chi nhánh" />
                                                <TableColumn fx:id="colTenCN" prefWidth="280" text="Tên chi nhánh" />
                                                <TableColumn fx:id="colDiaChiCN" prefWidth="420" text="Địa chỉ" />
                                                <TableColumn fx:id="colThaoTacCN" prefWidth="200" text="Thao tác" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <!-- Row Action Helper -->
                                        <HBox alignment="CENTER_RIGHT" spacing="10">
                                            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Thao tác chi nhánh đã chọn:" />
                                            <Button onAction="#onMoPopupSuaCN" prefHeight="35" prefWidth="110" style="-fx-background-color: #ECEBFA; -fx-background-radius: 10; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-cursor: hand;" text="Sửa">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                            <Button onAction="#onMoPopupXoaCN" prefHeight="35" prefWidth="90" style="-fx-background-color: #FDECEC; -fx-background-radius: 10; -fx-text-fill: #D9534F; -fx-font-weight: bold; -fx-cursor: hand;" text="Xóa">
                                                <cursor>
                                                    <Cursor fx:constant="HAND" />
                                                </cursor>
                                            </Button>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </Tab>

                        </tabs>
                    </TabPane>
                </center>
            </BorderPane>
        </center>
    </BorderPane>

    <!-- ======================================================== -->
    <!-- MODAL 1: THÊM NHÂN VIÊN MỚI                              -->
    <!-- ======================================================== -->
    <StackPane fx:id="modalThemNV" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
        <VBox alignment="TOP_CENTER" maxWidth="520" spacing="14" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0.2, 0, 10);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Thêm nhân viên mới" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Nhập các trường thông tin nhân viên ngân hàng" />

            <HBox spacing="12">
                <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Mã nhân viên" />
                    <TextField fx:id="txtModalThemMaNV" prefHeight="40" promptText="vd: NV009" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Họ tên nhân viên" />
                    <TextField fx:id="txtModalThemHoTenNV" prefHeight="40" promptText="vd: Nguyễn Văn A" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Số điện thoại" />
                    <TextField fx:id="txtModalThemSDTNV" prefHeight="40" promptText="vd: 0901234567" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Chức vụ" />
                    <TextField fx:id="txtModalThemChucVuNV" prefHeight="40" promptText="vd: Giao dịch viên, CSKH..." style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
                </VBox>
            </HBox>

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Địa chỉ" />
                <TextField fx:id="txtModalThemDiaChiNV" prefHeight="40" promptText="Địa chỉ cư trú của nhân viên" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 10 15;" />
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Chi nhánh làm việc" />
                <ComboBox fx:id="cboModalThemChiNhanhNV" maxWidth="Infinity" prefHeight="40" promptText="Chọn chi nhánh làm việc" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13; -fx-padding: 5 10;" />
            </VBox>

            <Label fx:id="lblModalThemNVLoi" style="-fx-font-size: 12px; -fx-text-fill: #D9534F;" text="" />

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button onAction="#onDongPopupThemNV" prefHeight="40" prefWidth="100" style="-fx-background-color: #F1F2F6; -fx-background-radius: 13; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Hủy">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
                <Button onAction="#onLuuThemNV" prefHeight="40" prefWidth="110" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Lưu">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>
        </VBox>
    </StackPane>

    <!-- ======================================================== -->
    <!-- MODAL 2: LIÊN KẾT TÀI KHOẢN ĐĂNG NHẬP                    -->
    <!-- ======================================================== -->
    <StackPane fx:id="modalLienKetTK" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
        <VBox alignment="TOP_CENTER" maxWidth="460" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 30, 0.2, 0, 10);">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Liên kết tài khoản đăng nhập" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Gán account chưa sử dụng cho nhân viên ngân hàng" />

            <!-- Fixed Info Box -->
            <VBox spacing="6" style="-fx-background-color: #F7F8FC; -fx-background-radius: 12; -fx-padding: 12 16;">
                <HBox spacing="10">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Mã NV:" />
