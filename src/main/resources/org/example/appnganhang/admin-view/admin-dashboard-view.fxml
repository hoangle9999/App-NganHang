<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.admin.AdminViewController">

    <BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: #F7F8FC;">

        <!-- LEFT SIDEBAR -->
        <left>
            <VBox prefWidth="235" spacing="8" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">
                <padding>
                    <Insets bottom="20" left="20" right="15" top="25" />
                </padding>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="SMART BANK" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #C9C9DD;" text="HỆ THỐNG QUẢN TRỊ ADMIN" />

                <Region prefHeight="15" />

                <!-- User Profile Badge -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-padding: 12 15;"><VBox alignment="CENTER" prefWidth="36" prefHeight="36" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 18;"><Label text="👤" style="-fx-font-size: 16px;" /></VBox><VBox spacing="4">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #BDBDD2;" text="Xin chào" />
                    <Label fx:id="lblAdminName" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Quản trị viên" />
                </VBox></HBox>

                <Region prefHeight="10" />

                <Label style="-fx-font-size: 10px; -fx-text-fill: #BDBDD2; -fx-padding: 0 0 5 5;" text="DANH MỤC QUẢN TRỊ" />

                <!-- Sidebar Nav Buttons -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <!-- Dashboard Active -->
                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTrangChu" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12; -fx-cursor: hand;" text="📊  Tổng quan Admin">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTaiKhoan" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="👤  Tài khoản &amp; Phân quyền">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onNhanVienChiNhanh" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="👥  Nhân viên &amp; Chi nhánh">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onCauHinhDanhMuc" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="⚙️  Cấu hình hệ thống">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                    <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onThongKeBaoCao" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="📈  Báo cáo &amp; Rủi ro">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>
                </VBox>

                <!-- Logout Button -->
                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;" text="🚪  Đăng xuất">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <BorderPane style="-fx-background-color: #F7F8FC;">
                <padding>
                    <Insets bottom="30" left="35" right="35" top="30" />
                </padding>

                <!-- PAGE HEADER -->
                <top>
                    <VBox spacing="5">
                        <padding>
                            <Insets bottom="20" />
                        </padding>
                        <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="Trung Tâm Quản Trị Hệ Thống - Admin Portal" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #85879A;" text="Giám sát vận hành toàn diện, phân quyền bảo mật, quản trị danh mục và kiểm soát rủi ro ngân hàng" />
                    </VBox>
                </top>

                <!-- CENTER BODY: OVERVIEW CARDS & QUICK ACCESS -->
                <center>
                    <VBox spacing="20">

                        <!-- TOP STATS ROW -->
                        <HBox spacing="16">
                            <!-- Stat 1 -->
                            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 20 22;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Tài khoản đăng nhập" />
                                <Label fx:id="lblStatTaiKhoan" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="1,250" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #10B981;" text="✓ Đã đồng bộ phân quyền" />
                            </VBox>

                            <!-- Stat 2 -->
                            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 20 22;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Nhân sự &amp; Chi nhánh" />
                                <Label fx:id="lblStatNhanVien" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="48 NV / 12 CN" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #5148C9;" text="100% tài khoản đã gán" />
                            </VBox>

                            <!-- Stat 3 -->
                            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 20 22;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Giao dịch hôm nay" />
                                <Label fx:id="lblStatGiaoDich" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="18.9 Tỷ VNĐ" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #85879A;" text="1,428 lượt giao dịch" />
                            </VBox>

                            <!-- Stat 4 -->
                            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 20 22;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Tài khoản bị khóa" />
                                <Label fx:id="lblStatCanhBao" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D9534F;" text="0 rủi ro cao" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #10B981;" text="✓ Hệ thống bảo mật an toàn" />
                            </VBox>
                        </HBox>

                        <!-- 4 MAIN MODULES GRID CARDS -->
                        <GridPane hgap="18.0" vgap="18" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
                                <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
                            </rowConstraints>

                            <!-- MODULE 1 CARD -->
                            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 22 25;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="1. Tài khoản &amp; Phân quyền" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 8; -fx-padding: 3 8;" text="Module 01" />
                                </HBox>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Tạo mới, chỉnh sửa, khóa tài khoản TaiKhoanDangNhap_VaiTro, phân bổ RoleName (Admin, CSKH, GDV, Khách hàng), đặt lại mật khẩu an toàn." wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button onAction="#onTaiKhoan" prefHeight="40" prefWidth="180" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Truy cập Quản lý →">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </VBox>

                            <!-- MODULE 2 CARD -->
                            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 22 25;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="2. Nhân viên &amp; Chi nhánh" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 8; -fx-padding: 3 8;" text="Module 02" />
                                </HBox>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Quản trị hồ sơ nhân sự, phân bổ chi nhánh công tác, cấp và liên kết tài khoản hệ thống cho từng nhân viên, quản lý danh sách chi nhánh." wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button onAction="#onNhanVienChiNhanh" prefHeight="40" prefWidth="180" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Truy cập Nhân sự →">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </VBox>

                            <!-- MODULE 3 CARD -->
                            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 22 25;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="3. Cấu hình Hệ thống &amp; Danh mục" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 8; -fx-padding: 3 8;" text="Module 03" />
                                </HBox>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Thiết lập gói hạn mức ngày, tra cứu và gán hạn mức cho tài khoản khách hàng, quản lý loại giao dịch và danh mục đối tác liên kết." wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button onAction="#onCauHinhDanhMuc" prefHeight="40" prefWidth="180" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Truy cập Cấu hình →">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </VBox>

                            <!-- MODULE 4 CARD -->
                            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5); -fx-padding: 22 25;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="10">
<!--                                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="4. Thống kê, Báo cáo &amp; Rủi ro" />-->
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5148C9; -fx-background-color: #ECEBFA; -fx-background-radius: 8; -fx-padding: 3 8;" text="Module 04" />
                                </HBox>
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #85879A;" text="Theo dõi toàn bộ lịch sử chuyển tiền, truy vết nhật ký kiểm toán (Audit Log) bất biến, phân tích rủi ro, xuất báo cáo Excel và in ấn." wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button onAction="#onThongKeBaoCao" prefHeight="40" prefWidth="180" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Truy cập Kiểm toán →">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </VBox>
                        </GridPane>

                    </VBox>
                </center>

            </BorderPane>
        </center>
    </BorderPane>
</StackPane>
