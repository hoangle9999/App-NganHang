<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.BaoCaoController"
            prefWidth="1280"
            prefHeight="760"
            style="-fx-background-color: #F7F8FC;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="235"
              spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9);">

            <padding>
                <Insets top="25" right="15" bottom="20" left="20"/>
            </padding>

            <Label text="SMART BANK"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="YOUR SMART BANKING"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #C9C9DD;"/>

            <Region prefHeight="15"/>

            <VBox spacing="4"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;">

                <Label text="Xin chào"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #BDBDD2;"/>

                <Label text="Người dùng"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
            </VBox>

            <Region prefHeight="10"/>

            <Label text="MENU"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #BDBDD2;
                          -fx-padding: 0 0 5 5;"/>

            <VBox spacing="4" VBox.vgrow="ALWAYS">

                <Button text="Khách hàng"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onKhachHang"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Tài khoản"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onTaiKhoan"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Chuyển tiền"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onChuyenTien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Tra cứu giao dịch"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onTraCuuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Lịch sử giao dịch"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onLichSuGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Hạn mức"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onHanMuc"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Loại giao dịch"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onLoaiGiaoDich"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Chi nhánh"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onChiNhanh"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Nhân viên"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onNhanVien"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <!-- ACTIVE -->
                <Button text="Báo cáo"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onBaoCao"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"/>

                <Button text="Đổi mật khẩu"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#onDoiMatKhau"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #D0D0E0;
                               -fx-font-size: 13px;
                               -fx-padding: 10 12;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

            </VBox>

            <Button text="Đăng xuất"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#onDangXuat"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"/>

        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <top>
                <VBox spacing="5">
                    <Label text="Báo cáo"
                           style="-fx-font-size: 27px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #171A35;"/>

                    <Label text="Thống kê và theo dõi tình hình giao dịch của hệ thống"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #85879A;"/>
                </VBox>
            </top>

            <center>
                <VBox spacing="18">

                    <!-- BỘ LỌC -->
                    <VBox spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                        <padding>
                            <Insets top="20" right="25" bottom="20" left="25"/>
                        </padding>

                        <Label text="Bộ lọc báo cáo"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>

                        <HBox spacing="15">

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Từ ngày"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"/>

                                <TextField fx:id="txtTuNgay"
                                           promptText="dd/MM/yyyy"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Đến ngày"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"/>

                                <TextField fx:id="txtDenNgay"
                                           promptText="dd/MM/yyyy"
                                           style="-fx-background-color: white;
                                                  -fx-background-radius: 13;
                                                  -fx-border-color: #E0E1E8;
                                                  -fx-border-radius: 13;
                                                  -fx-padding: 10 15;"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Loại báo cáo"
                                       style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4B5563;"/>

                                <ComboBox fx:id="cboLoaiBaoCao"
                                          promptText="Chọn loại báo cáo"
                                          maxWidth="Infinity"
                                          style="-fx-background-color: white;
                                                 -fx-background-radius: 13;
                                                 -fx-border-color: #E0E1E8;
                                                 -fx-border-radius: 13;"/>
                            </VBox>

                        </HBox>

                        <HBox spacing="10">

                            <Button fx:id="btnThongKe"
                                    text="Thống kê"
                                    onAction="#onThongKe"
                                    prefWidth="110"
                                    prefHeight="40"
                                    style="-fx-background-color: #5148C9;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="btnLamMoi"
                                    text="Làm mới"
                                    onAction="#onLamMoi"
                                    prefWidth="100"
                                    prefHeight="40"
                                    style="-fx-background-color: #F1F2F6;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: #555A70;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="btnXuatBaoCao"
                                    text="Xuất báo cáo"
                                    onAction="#onXuatBaoCao"
                                    prefWidth="120"
                                    prefHeight="40"
                                    style="-fx-background-color: #ECEBFA;
                                           -fx-background-radius: 13;
                                           -fx-text-fill: #5148C9;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;"/>

                        </HBox>

                    </VBox>

                    <!-- THỐNG KÊ -->
                    <HBox spacing="15">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);">

                            <padding>
                                <Insets top="15" right="20" bottom="15" left="20"/>
                            </padding>

                            <Label text="Tổng số giao dịch"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #85879A;"/>

                            <Label fx:id="lblTongSoGiaoDich"
                                   text="0"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #171A35;"/>

                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);">

                            <padding>
                                <Insets top="15" right="20" bottom="15" left="20"/>
                            </padding>

                            <Label text="Tổng tiền giao dịch"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #85879A;"/>

                            <Label fx:id="lblTongTien"
                                   text="0 VNĐ"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #171A35;"/>

                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);">

                            <padding>
                                <Insets top="15" right="20" bottom="15" left="20"/>
                            </padding>

                            <Label text="Giao dịch thành công"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #85879A;"/>

                            <Label fx:id="lblGiaoDichThanhCong"
                                   text="0"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #2E8B57;"/>

                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.06), 15, 0.12, 0, 4);">

                            <padding>
                                <Insets top="15" right="20" bottom="15" left="20"/>
                            </padding>

                            <Label text="Giao dịch thất bại"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #85879A;"/>

                            <Label fx:id="lblGiaoDichThatBai"
                                   text="0"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #D9534F;"/>

                        </VBox>

                    </HBox>

                    <!-- TABLE -->
                    <VBox spacing="12"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Chi tiết báo cáo"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>

                        <TableView fx:id="tblBaoCao"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="colMaGiaoDich"
                                             text="Mã giao dịch"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colTaiKhoanNguon"
                                             text="TK nguồn"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colTaiKhoanDich"
                                             text="TK đích"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colSoTien"
                                             text="Số tiền"
                                             prefWidth="130"/>

                                <TableColumn fx:id="colNgayGiaoDich"
                                             text="Ngày giao dịch"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colLoaiGiaoDich"
                                             text="Loại giao dịch"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colTrangThai"
                                             text="Trạng thái"
                                             prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>