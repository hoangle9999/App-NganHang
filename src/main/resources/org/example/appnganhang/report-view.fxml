<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.BaoCaoController"
            prefWidth="1280"
            prefHeight="760"
            style="-fx-background-color: #F7F8FC;">

    <!-- ================= SIDEBAR TRÁI ================= -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #262261;"
              spacing="8">
            <padding>
                <Insets top="25" right="15" bottom="20" left="20"/>
            </padding>

            <!-- Logo / Brand -->
            <Label text="SMART BANK"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="YOUR SMART BANKING"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;"/>

            <Region prefHeight="15"/>

            <!-- User Info Box -->
            <VBox style="-fx-background-color: rgba(255, 255, 255, 0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;"
                  spacing="3">
                <Label text="Xin chào"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #A0A0C0;"/>
                <Label text="Người dùng"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
            </VBox>

            <Region prefHeight="10"/>
            <Label text="MENU"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;
                          -fx-padding: 0 0 5 5;"/>

            <!-- Danh sách menu điều hướng dọc -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button text="Khách hàng" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Tài khoản" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chuyển tiền" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Tra cứu giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Lịch sử giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Hạn mức" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Loại giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chi nhánh" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Nhân viên" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>

                <!-- Mục đang chọn: Báo cáo -->
                <Button text="Báo cáo"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: rgba(255, 255, 255, 0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"/>

                <Button text="Đổi mật khẩu" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
            </VBox>

            <!-- Đăng xuất -->
            <Button text="Đăng xuất"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: rgba(255, 255, 255, 0.08);
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH BÊN PHẢI ================= -->
    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- Header phải & Khung lọc -->
            <top>
                <VBox spacing="15">
                    <VBox spacing="4">
                        <Label text="Báo cáo - Thống kê"
                               style="-fx-font-size: 26px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>
                        <Label text="Thống kê báo cáo giao dịch hệ thống theo thời gian và tiêu chí"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #85879A;"/>
                    </VBox>

                    <!-- Khung tìm kiếm/lọc báo cáo -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E6E7EF;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;">
                        <padding>
                            <Insets top="16" right="20" bottom="16" left="20"/>
                        </padding>
                        <Label text="Bộ lọc thống kê"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>

                        <GridPane hgap="15.0" vgap="12.0">
                            <Label text="Từ ngày:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #4B5563;"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="txtTuNgay"
                                       prefWidth="180.0"
                                       promptText="yyyy-MM-dd"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 8; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Đến ngày:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #4B5563;"
                                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <TextField fx:id="txtDenNgay"
                                       prefWidth="180.0"
                                       promptText="yyyy-MM-dd"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 8; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;"
                                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <Label text="Loại báo cáo:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #4B5563;"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cboLoaiBaoCao"
                                      prefWidth="200.0"
                                      promptText="Chọn loại báo cáo"
                                      style="-fx-background-color: #F7F8FC; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <HBox spacing="10.0" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                <Button fx:id="btnThongKe"
                                        mnemonicParsing="false"
                                        prefWidth="120.0"
                                        text="Thống kê"
                                        style="-fx-background-color: #5148C9; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 0; -fx-cursor: hand;"/>

                                <Button fx:id="btnLamMoi"
                                        mnemonicParsing="false"
                                        prefWidth="120.0"
                                        text="Làm mới"
                                        style="-fx-background-color: #E9E8FF; -fx-background-radius: 8; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-padding: 9 0; -fx-cursor: hand;"/>
                            </HBox>
                        </GridPane>
                    </VBox>
                </VBox>
            </top>

            <!-- Center phải: Tổng quan số liệu & Bảng dữ liệu -->
            <center>
                <VBox spacing="12">
                    <Region prefHeight="5"/>

                    <!-- Khung hiển thị các nhãn thống kê nhanh -->
                    <HBox spacing="15.0" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E6E7EF; -fx-border-radius: 12; -fx-border-width: 1;">
                        <padding>
                            <Insets top="14" right="20" bottom="14" left="20"/>
                        </padding>

                        <Label fx:id="lblTongSoGiaoDich"
                               text="Tổng số giao dịch: 0"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #171A35;"/>
                        <Label text="|" style="-fx-text-fill: #D1D5DB;"/>
                        <Label fx:id="lblTongTien"
                               text="Tổng tiền: 0"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        <Label text="|" style="-fx-text-fill: #D1D5DB;"/>
                        <Label fx:id="lblGiaoDichThanhCong"
                               text="Giao dịch thành công: 0"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                        <Label text="|" style="-fx-text-fill: #D1D5DB;"/>
                        <Label fx:id="lblGiaoDichThatBai"
                               text="Giao dịch thất bại: 0"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                    </HBox>

                    <!-- TableView -->
                    <TableView fx:id="tblBaoCao"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colMaGiaoDich"
                                         prefWidth="130.0"
                                         text="Mã giao dịch"/>
                            <TableColumn fx:id="colTaiKhoanNguon"
                                         prefWidth="150.0"
                                         text="TK nguồn"/>
                            <TableColumn fx:id="colTaiKhoanDich"
                                         prefWidth="150.0"
                                         text="TK đích"/>
                            <TableColumn fx:id="colSoTien"
                                         prefWidth="140.0"
                                         text="Số tiền"/>
                            <TableColumn fx:id="colNgayGiaoDich"
                                         prefWidth="170.0"
                                         text="Ngày giao dịch"/>
                            <TableColumn fx:id="colLoaiGiaoDich"
                                         prefWidth="150.0"
                                         text="Loại giao dịch"/>
                            <TableColumn fx:id="colTrangThai"
                                         prefWidth="130.0"
                                         text="Trạng thái"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </center>

            <!-- Bottom phải: Nút xuất báo cáo -->
            <bottom>
                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <padding>
                        <Insets top="15" right="0" bottom="0" left="0"/>
                    </padding>

                    <Button fx:id="btnXuatBaoCao"
                            mnemonicParsing="false"
                            prefWidth="140.0"
                            text="Xuất báo cáo"
                            style="-fx-background-color: #5148C9; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 0; -fx-cursor: hand;"/>
                </HBox>
            </bottom>

        </BorderPane>
    </center>

</BorderPane>