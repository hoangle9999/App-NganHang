<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.KhachHangController"
            prefWidth="1100"
            prefHeight="750"
            style="-fx-background-color: #F7F8FC;">

    <padding>
        <Insets top="35"
                right="40"
                bottom="35"
                left="40"/>
    </padding>

    <!-- ================= HEADER ================= -->

    <top>
        <VBox spacing="5">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Quản lý khách hàng"
                           style="-fx-font-size: 29px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #171A35;"/>
                    <Label text="Quản lý, thêm mới và tra cứu thông tin khách hàng hệ thống"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #85879A;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnLamMoi"
                        text="Làm mới"
                        onAction="#onLamMoi"
                        mnemonicParsing="false"
                        style="-fx-background-color: #E9E8FF;
                               -fx-background-radius: 11;
                               -fx-text-fill: #5148C9;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 11 18;
                               -fx-cursor: hand;"/>
            </HBox>
            <Region prefHeight="10"/>
        </VBox>
    </top>


    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <HBox spacing="20">

            <!-- CỘT TRÁI: FORM NHẬP THÔNG TIN KHÁCH HÀNG -->
            <VBox spacing="15"
                  prefWidth="350"
                  maxWidth="350"
                  style="-fx-background-color: white;
                         -fx-background-radius: 18;
                         -fx-border-color: #E6E7EF;
                         -fx-border-radius: 18;
                         -fx-border-width: 1;">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Thông tin chi tiết"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #171A35;"/>

                <VBox spacing="10" VBox.vgrow="ALWAYS">

                    <!-- Mã khách hàng -->
                    <VBox spacing="5">
                        <Label text="Mã khách hàng" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtMaKhachHang" promptText="VD: KH001"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <!-- Họ tên -->
                    <VBox spacing="5">
                        <Label text="Họ và tên" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtHoTen" promptText="Nhập họ tên đầy đủ"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <!-- CCCD -->
                    <VBox spacing="5">
                        <Label text="Số CCCD" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtCCCD" promptText="Nhập 12 số CCCD"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <!-- Số điện thoại -->
                    <VBox spacing="5">
                        <Label text="Số điện thoại" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtSoDienThoai" promptText="Nhập số điện thoại"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="5">
                        <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtEmail" promptText="example@email.com"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                    <!-- Tên đăng nhập -->
                    <VBox spacing="5">
                        <Label text="Tên đăng nhập" style="-fx-font-size: 12px; -fx-text-fill: #5A5C69; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtTenDangNhap" promptText="Tên đăng nhập app"
                                   style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10;"/>
                    </VBox>

                </VBox>

                <!-- KHU VỰC NÚT THAO TÁC FORM -->
                <VBox spacing="10">
                    <Button fx:id="btnThem"
                            text="Thêm mới"
                            onAction="#onThem"
                            mnemonicParsing="false"
                            maxWidth="Infinity"
                            style="-fx-background-color: #5148C9;
                                   -fx-background-radius: 10;
                                   -fx-text-fill: white;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 11;
                                   -fx-cursor: hand;"/>

                    <HBox spacing="10">
                        <Button fx:id="btnSua"
                                text="Cập nhật"
                                onAction="#onSua"
                                mnemonicParsing="false"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                style="-fx-background-color: #E9E8FF;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: #5148C9;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 11;
                                       -fx-cursor: hand;"/>

                        <Button fx:id="btnXoa"
                                text="Xóa"
                                onAction="#onXoa"
                                mnemonicParsing="false"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                style="-fx-background-color: #FFF0F0;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: #D64545;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 11;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

            </VBox>


            <!-- CỘT PHẢI: TÌM KIẾM & BẢNG DANH SÁCH -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- SEARCH CARD -->
                <VBox spacing="10"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-border-color: #E6E7EF;
                             -fx-border-radius: 18;
                             -fx-border-width: 1;">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>
                    <Label text="Tìm kiếm khách hàng"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #171A35;"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtTimKiem"
                                   promptText="Nhập mã khách hàng, họ tên, CCCD hoặc số điện thoại cần tìm..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #F7F8FC;
                                          -fx-background-radius: 10;
                                          -fx-border-color: #E6E7EF;
                                          -fx-border-radius: 10;
                                          -fx-border-width: 1;
                                          -fx-padding: 10 14;
                                          -fx-font-size: 13px;"/>

                        <Button fx:id="btnTimKiem"
                                text="Tìm kiếm"
                                onAction="#onTimKiem"
                                mnemonicParsing="false"
                                style="-fx-background-color: #5148C9;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 10 18;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>


                <!-- TABLE CARD -->
                <VBox spacing="12"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-border-color: #E6E7EF;
                             -fx-border-radius: 18;
                             -fx-border-width: 1;">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Danh sách khách hàng"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Chọn một dòng để xem hoặc chỉnh sửa"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #85879A;"/>
                    </HBox>

                    <TableView fx:id="tblKhachHang"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: #E6E7EF;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colMaKhachHang" text="Mã KH" prefWidth="90"/>
                            <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="140"/>
                            <TableColumn fx:id="colCCCD" text="CCCD" prefWidth="110"/>
                            <TableColumn fx:id="colSoDienThoai" text="Số điện thoại" prefWidth="110"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                            <TableColumn fx:id="colTenDangNhap" text="Tên đăng nhập" prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>