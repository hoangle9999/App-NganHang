<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.RegisterController"
            prefWidth="1100.0"
            prefHeight="750.0"
            style="-fx-background-color: #F7F8FC;">

    <!-- ================= LEFT ================= -->

    <left>
        <VBox prefWidth="430.0"
              alignment="CENTER"
              spacing="10"
              style="-fx-background-color: #171A35;">

            <VBox spacing="5"
                  alignment="CENTER">

                <Label text="SMART BANK"
                       style="-fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;"/>

                <Label text="YOUR SMART BANKING"
                       style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 12px;"/>

                <Region prefHeight="25"/>

                <Label text="Đăng ký tài khoản"
                       style="-fx-text-fill: white;
                              -fx-font-size: 25px;
                              -fx-font-weight: bold;"/>

                <Label text="Trải nghiệm ngân hàng thông minh"
                       style="-fx-text-fill: #BFC2D8;
                              -fx-font-size: 13px;"/>

            </VBox>

        </VBox>
    </left>

    <!-- ================= RIGHT ================= -->

    <center>

        <VBox alignment="CENTER"
              spacing="18">

            <padding>
                <Insets top="40"
                        right="70"
                        bottom="40"
                        left="70"/>
            </padding>

            <VBox maxWidth="500"
                  spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                <padding>
                    <Insets top="35"
                            right="40"
                            bottom="35"
                            left="40"/>
                </padding>

                <!-- TITLE -->

                <VBox spacing="5">

                    <Label text="Tạo tài khoản"
                           style="-fx-text-fill: #171A35;
                                  -fx-font-size: 26px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Nhập thông tin để đăng ký tài khoản"
                           style="-fx-text-fill: #777B91;
                                  -fx-font-size: 13px;"/>

                </VBox>

                <!-- HỌ TÊN -->

                <VBox spacing="6">

                    <Label text="Họ và tên"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtHoTen"
                               promptText="Nhập họ và tên"
                               prefHeight="45"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 13;
                                      -fx-border-color: #E0E1E8;
                                      -fx-border-radius: 13;
                                      -fx-padding: 0 15;"/>

                </VBox>

                <!-- CCCD -->

                <VBox spacing="6">

                    <Label text="CCCD"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtCCCD"
                               promptText="Nhập số CCCD"
                               prefHeight="45"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 13;
                                      -fx-border-color: #E0E1E8;
                                      -fx-border-radius: 13;
                                      -fx-padding: 0 15;"/>

                </VBox>

                <!-- SỐ ĐIỆN THOẠI -->

                <VBox spacing="6">

                    <Label text="Số điện thoại"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtSoDienThoai"
                               promptText="Nhập số điện thoại"
                               prefHeight="45"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 13;
                                      -fx-border-color: #E0E1E8;
                                      -fx-border-radius: 13;
                                      -fx-padding: 0 15;"/>

                </VBox>

                <!-- EMAIL -->

                <VBox spacing="6">

                    <Label text="Email"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtEmail"
                               promptText="Nhập email"
                               prefHeight="45"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 13;
                                      -fx-border-color: #E0E1E8;
                                      -fx-border-radius: 13;
                                      -fx-padding: 0 15;"/>

                </VBox>

                <!-- TÊN ĐĂNG NHẬP -->

                <VBox spacing="6">

                    <Label text="Tên đăng nhập"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <TextField fx:id="txtTenDangNhap"
                               promptText="Nhập tên đăng nhập"
                               prefHeight="45"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 13;
                                      -fx-border-color: #E0E1E8;
                                      -fx-border-radius: 13;
                                      -fx-padding: 0 15;"/>

                </VBox>

                <!-- MẬT KHẨU -->

                <VBox spacing="6">

                    <Label text="Mật khẩu"
                           style="-fx-text-fill: #4D5063;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <PasswordField fx:id="txtMatKhau"
                                   promptText="Nhập mật khẩu"
                                   prefHeight="45"
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 13;
                                          -fx-border-color: #E0E1E8;
                                          -fx-border-radius: 13;
                                          -fx-padding: 0 15;"/>

                </VBox>

                <!-- THÔNG BÁO -->

                <Label fx:id="lblThongBao"
                       text=""
                       wrapText="true"
                       minHeight="25"
                       style="-fx-font-size: 12px;"/>

                <!-- BUTTON -->

                <Button fx:id="btnDangKy"
                        text="Đăng ký tài khoản"
                        maxWidth="Infinity"
                        prefHeight="46"
                        onAction="#onRegisterButtonClick"
                        style="-fx-background-color: #5148C9;
                               -fx-background-radius: 13;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;"/>

                <!-- QUAY LẠI -->

                <HBox alignment="CENTER"
                      spacing="5">

                    <Label text="Đã có tài khoản?"
                           style="-fx-text-fill: #777B91;
                                  -fx-font-size: 12px;"/>

                    <Button text="Đăng nhập"
                            onAction="#onBackToLogin"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #5148C9;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 0;"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>