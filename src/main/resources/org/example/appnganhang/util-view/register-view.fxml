<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.util.RegisterController">

    <!-- ================= LEFT ================= -->

    <left>
        <VBox alignment="CENTER" prefWidth="430.0" spacing="10" style="-fx-background-color: #171A35;">

            <VBox alignment="CENTER" spacing="5">

                <Label style="-fx-text-fill: white;                               -fx-font-size: 32px;                               -fx-font-weight: bold;" text="SMART BANK" />

                <Label style="-fx-text-fill: #BFC2D8;                               -fx-font-size: 12px;" text="YOUR SMART BANKING" />

                <Region prefHeight="25" />

                <Label style="-fx-text-fill: white;                               -fx-font-size: 25px;                               -fx-font-weight: bold;" text="Đăng ký tài khoản" />

                <Label style="-fx-text-fill: #BFC2D8;                               -fx-font-size: 13px;" text="Trải nghiệm ngân hàng thông minh" />

            </VBox>

        </VBox>
    </left>

    <!-- ================= RIGHT ================= -->

    <center>

        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets bottom="40" left="70" right="70" top="40" />
            </padding>

            <VBox maxWidth="500" spacing="18" style="-fx-background-color: white;                          -fx-background-radius: 20;                          -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">

                <padding>
                    <Insets bottom="35" left="40" right="40" top="35" />
                </padding>

                <!-- TITLE -->

                <VBox spacing="5">

                    <Label style="-fx-text-fill: #171A35;                                   -fx-font-size: 26px;                                   -fx-font-weight: bold;" text="Tạo tài khoản" />

                    <Label style="-fx-text-fill: #777B91;                                   -fx-font-size: 13px;" text="Nhập thông tin để đăng ký tài khoản" />

                </VBox>

                <!-- HỌ TÊN -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Họ và tên" />

                    <TextField fx:id="txtHoTen" prefHeight="45" promptText="Nhập họ và tên" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />

                </VBox>

                <!-- CCCD -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="CCCD" />

                    <TextField fx:id="txtCCCD" prefHeight="45" promptText="Nhập số CCCD" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />

                </VBox>
            <VBox layoutX="50.0" layoutY="194.0" spacing="6">
               <children>
                  <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Địa chỉ" />
                  <TextField fx:id="txtDiaChi" prefHeight="45" promptText="Nhập địa chỉ" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />
               </children>
            </VBox>

                <!-- SỐ ĐIỆN THOẠI -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Số điện thoại" />

                    <TextField fx:id="txtSoDienThoai" prefHeight="45" promptText="Nhập số điện thoại" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />

                </VBox>

                <!-- EMAIL -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Email" />

                    <TextField fx:id="txtEmail" prefHeight="45" promptText="Nhập email" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />

                </VBox>

                <!-- TÊN ĐĂNG NHẬP -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Tên đăng nhập" />

                    <TextField fx:id="txtTenDangNhap" prefHeight="45" promptText="Nhập tên đăng nhập" style="-fx-background-color: white;                                       -fx-background-radius: 13;                                       -fx-border-color: #E0E1E8;                                       -fx-border-radius: 13;                                       -fx-padding: 0 15;" />

                </VBox>

                <!-- MẬT KHẨU -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill: #4D5063;                                   -fx-font-size: 12px;                                   -fx-font-weight: bold;" text="Mật khẩu" />

                    <PasswordField fx:id="txtMatKhau" onAction="#onRegisterButtonClick" prefHeight="45" promptText="Nhập mật khẩu" style="-fx-background-color: white;                                           -fx-background-radius: 13;                                           -fx-border-color: #E0E1E8;                                           -fx-border-radius: 13;                                           -fx-padding: 0 15;" />

                </VBox>

                <!-- THÔNG BÁO -->

                <Label fx:id="lblThongBao" minHeight="25" style="-fx-font-size: 12px;" text="" wrapText="true" />

                <!-- BUTTON -->

                <Button fx:id="btnDangKy" maxWidth="Infinity" onAction="#onRegisterButtonClick" prefHeight="46" style="-fx-background-color: #5148C9;                                -fx-background-radius: 13;                                -fx-text-fill: white;                                -fx-font-size: 14px;                                -fx-font-weight: bold;" text="Đăng ký tài khoản">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <!-- QUAY LẠI -->

                <HBox alignment="CENTER" spacing="5">

                    <Label style="-fx-text-fill: #777B91;                                   -fx-font-size: 12px;" text="Đã có tài khoản?" />

                    <Button onAction="#onBackToLogin" style="-fx-background-color: transparent;                                    -fx-text-fill: #5148C9;                                    -fx-font-size: 12px;                                    -fx-font-weight: bold;                                    -fx-padding: 0;" text="Đăng nhập">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Button>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>
