<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="720.0"
           maxWidth="500.0"
           minHeight="720.0"
           minWidth="500.0"
           prefHeight="720.0"
           prefWidth="500.0"
           style="-fx-background-color: linear-gradient(to bottom right, #FAFAFF, #EEF0FF);"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.appnganhang.controller.util.LoginController">

    <VBox alignment="TOP_CENTER"
          maxWidth="430"
          prefWidth="430"
          spacing="0">

        <padding>
            <Insets bottom="30"
                    left="35"
                    right="35"
                    top="35" />
        </padding>

        <!-- TÊN NGÂN HÀNG -->

        <Label style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #111426;"
               text="SMART BANK" />

        <Label style="-fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #777B8A;"
               text="YOUR SMART BANKING"
               translateY="5" />

        <Region prefHeight="28" />

        <!-- BANK CARD -->

        <StackPane maxHeight="205"
                   maxWidth="360"
                   prefHeight="205"
                   prefWidth="360"
                   style="-fx-background-color: linear-gradient(to bottom right, #171A35, #4C45C7);
                          -fx-background-radius: 25;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 20, 0.2, 0, 8);">

            <VBox spacing="0">

                <padding>
                    <Insets bottom="20"
                            left="25"
                            right="25"
                            top="22" />
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <Label style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"
                           text="SMART BANK" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"
                           text="VISA" />

                </HBox>

                <Region prefHeight="35" />

                <Label style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"
                       text="••••  ••••  ••••  4800" />

                <Region prefHeight="15" />

                <HBox>

                    <VBox>

                        <Label style="-fx-font-size: 8px;
                                      -fx-text-fill: #D8D8EE;"
                               text="CARD HOLDER" />

                        <Label style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"
                               text="SMART BANK USER" />

                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox alignment="CENTER_RIGHT">

                        <Label style="-fx-font-size: 8px;
                                      -fx-text-fill: #D8D8EE;"
                               text="VALID THRU" />

                        <Label style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"
                               text="12/29" />

                    </VBox>

                </HBox>

            </VBox>

        </StackPane>

        <Region prefHeight="32" />

        <!-- WELCOME -->

        <VBox alignment="CENTER_LEFT"
              maxWidth="360"
              spacing="6">

            <Label style="-fx-font-size: 27px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #111426;"
                   text="Welcome back" />

            <Label style="-fx-font-size: 13px;
                          -fx-text-fill: #777B8A;"
                   text="Đăng nhập để tiếp tục sử dụng dịch vụ ngân hàng"
                   wrapText="true" />

        </VBox>

        <Region prefHeight="22" />

        <!-- TÊN ĐĂNG NHẬP -->

        <VBox maxWidth="360"
              spacing="7">

            <Label style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #343746;"
                   text="Tên đăng nhập" />

            <TextField fx:id="txtTenDangNhap"
                       maxWidth="360"
                       prefHeight="48"
                       promptText="Nhập tên đăng nhập"
                       style="-fx-background-color: white;
                              -fx-background-radius: 13;
                              -fx-border-color: #E0E1E8;
                              -fx-border-radius: 13;
                              -fx-border-width: 1;
                              -fx-padding: 0 15;
                              -fx-font-size: 13px;" />

        </VBox>

        <Region prefHeight="15" />

        <!-- MẬT KHẨU -->

        <VBox maxWidth="360"
              spacing="7">

            <Label style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #343746;"
                   text="Mật khẩu" />

            <PasswordField fx:id="txtMatKhau"
                           maxWidth="360"
                           onAction="#onLoginButtonClick"
                           prefHeight="48"
                           promptText="Nhập mật khẩu"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 13;
                                  -fx-border-color: #E0E1E8;
                                  -fx-border-radius: 13;
                                  -fx-border-width: 1;
                                  -fx-padding: 0 15;
                                  -fx-font-size: 13px;" />

        </VBox>

        <Region prefHeight="8" />

        <!-- THÔNG BÁO -->

        <Label fx:id="lblThongBao"
               maxWidth="360"
               minHeight="18"
               style="-fx-font-size: 11px;
                      -fx-text-fill: #E53935;"
               wrapText="true" />

        <Region prefHeight="5" />

        <!-- ĐĂNG NHẬP -->

        <Button maxWidth="360"
                mnemonicParsing="false"
                onAction="#onLoginButtonClick"
                prefHeight="50"
                style="-fx-background-color: #111426;
                       -fx-background-radius: 14;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"
                text="ĐĂNG NHẬP">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Region prefHeight="18" />

        <!-- ĐĂNG KÝ -->

        <HBox alignment="CENTER"
              spacing="5">

            <Label style="-fx-font-size: 12px;
                          -fx-text-fill: #777B8A;"
                   text="Chưa có tài khoản?" />

            <Button mnemonicParsing="false"
                    onAction="#onRegisterLinkClick"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #635BDB;
                           -fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-padding: 0;
                           -fx-cursor: hand;"
                    text="Đăng ký">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>

        </HBox>

        <Region prefHeight="8" />

        <!-- THOÁT -->

        <Button mnemonicParsing="false"
                onAction="#onExitButtonClick"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #999AAA;
                       -fx-font-size: 11px;
                       -fx-cursor: hand;"
                text="Thoát">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

    </VBox>

</StackPane>