<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="550.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.TransferController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    children:
    <children>
        <Label text="CHUYỂN TIỀN NHANH">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Số tài khoản thụ hưởng:" />
        <TextField fx:id="txtSoTaiKhoanNhan" promptText="Nhập số tài khoản nhận" style="-fx-font-size: 14;" />

        <Label text="Ngân hàng thụ hưởng:" />
        <ComboBox fx:id="cbNganHang" prefHeight="30.0" prefWidth="250.0" promptText="Chọn ngân hàng" />

        <Label text="Số tiền chuyển (VNĐ):" />
        <TextField fx:id="txtSoTien" promptText="Nhập số tiền" style="-fx-font-size: 14;" />

        <Label text="Nội dung chuyển khoản:" />
        <TextArea fx:id="txtNoiDung" prefHeight="70.0" prefWidth="200.0" promptText="Ví dụ: Nguyen Van A chuyen tien" style="-fx-font-size: 13;" />

        <Button fx:id="btnXacNhan" mnemonicParsing="false" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" text="Xác nhận chuyển khoản" />
    </children>
</VBox>