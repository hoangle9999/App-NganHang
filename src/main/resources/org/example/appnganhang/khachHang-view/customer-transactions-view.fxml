<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #F7F8FC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.controller.khachhang.CustomerTransactionsController">
    <children>
        <BorderPane>
            <!-- SIDEBAR TRÁI -->
            <left>
                <VBox prefWidth="235.0" style="-fx-background-color: linear-gradient(to bottom, #171A35, #5148C9); -fx-padding: 25 15 20 20;">
                    <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="SMART BANK" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #C9C9DD;" text="YOUR SMART BANKING" />

                        <Region prefHeight="15.0" />

                        <VBox spacing="4.0" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 12; -fx-padding: 12 15;">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #BDBDD2;" text="Khách hàng" />
                                <Label fx:id="lblSidebarTenKH" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nguyễn Văn A" />
                                <Label fx:id="lblSidebarMaKH" style="-fx-font-size: 11px; -fx-text-fill: #93C5FD;" text="Mã KH: KH0001" />
                            </children>
                        </VBox>

                        <Region prefHeight="15.0" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #BDBDD2; -fx-padding: 0 0 5 5;" text="DỊCH VỤ CỦA TÔI" />

                        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onTrangChu" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="🏠  Trang chủ &amp; Tài khoản">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>

                                <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 12; -fx-cursor: hand;" text="📑  Lịch sử giao dịch">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>

                                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onBienDongSoDu" style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 10; -fx-cursor: hand;" text="📊  Biến động số dư">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </VBox>

                        <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#onDangXuat" style="-fx-background-color: transparent; -fx-background-radius: 10; -fx-text-fill: #FCA5A5; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;" text="🚪  Đăng xuất">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                    </children>
                </VBox>
            </left>

            <!-- NỘI DUNG CHÍNH (CENTER) -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background: #F7F8FC; -fx-background-color: #F7F8FC; -fx-border-color: transparent;">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 25 30 30 30;">
                            <children>
                                <!-- HEADER TIÊU ĐỀ -->
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="LỊCH SỬ GIAO DỊCH CHUYỂN TIỀN" />
                                                <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" text="Xem danh sách giao dịch chuyển đi và nhận tiền của bạn theo trạng thái và thời gian" />
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#onLamMoi" prefHeight="40.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 12; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16; -fx-font-size: 12px;" text="🔄 Làm mới">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </HBox>

                                <!-- KHUNG BỘ LỌC DỮ LIỆU -->
                                <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);">
                                    <children>
                                        <GridPane hgap="14.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="30.0" />
                                                <ColumnConstraints percentWidth="25.0" />
                                                <ColumnConstraints percentWidth="25.0" />
                                                <ColumnConstraints percentWidth="20.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                            </rowConstraints>
                                            <children>
                                                <!-- Dropdown tài khoản -->
                                                <VBox spacing="6.0" GridPane.columnIndex="0">
                                                    <children>
                                                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Tài khoản tra cứu *" />
                                                        <ComboBox fx:id="cboChonTaiKhoan" maxWidth="Infinity" onAction="#onApDungLoc" prefHeight="42.0" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13;" />
                                                    </children>
                                                </VBox>

                                                <!-- Từ ngày -->
                                                <VBox spacing="6.0" GridPane.columnIndex="1">
                                                    <children>
                                                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Từ ngày" />
                                                        <DatePicker fx:id="dpTuNgay" maxWidth="Infinity" prefHeight="42.0" promptText="Từ ngày" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13;" />
                                                    </children>
                                                </VBox>

                                                <!-- Đến ngày -->
                                                <VBox spacing="6.0" GridPane.columnIndex="2">
                                                    <children>
                                                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="Đến ngày" />
                                                        <DatePicker fx:id="dpDenNgay" maxWidth="Infinity" prefHeight="42.0" promptText="Đến ngày" style="-fx-background-color: white; -fx-background-radius: 13; -fx-border-color: #E0E1E8; -fx-border-radius: 13;" />
                                                    </children>
                                                </VBox>

                                                <!-- Nút Áp dụng lọc -->
                                                <VBox alignment="BOTTOM_LEFT" spacing="6.0" GridPane.columnIndex="3">
                                                    <children>
                                                        <Button fx:id="btnApDungLoc" maxWidth="Infinity" onAction="#onApDungLoc" prefHeight="42.0" style="-fx-background-color: #5148C9; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Áp dụng lọc">
                                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>

                                        <Separator />

                                        <!-- CÁC TAB LỌC TRẠNG THÁI -->
                                        <HBox spacing="10.0">
                                            <children>
                                                <!-- Tab Tất cả -->
                                                <Button fx:id="btnTabTatCa" onAction="#onChonTabTatCa" prefHeight="38.0" style="-fx-background-color: #5148C9; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;" text="Tất cả (0)">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>

                                                <!-- Tab Thành công (Xanh) -->
                                                <Button fx:id="btnTabThanhCong" onAction="#onChonTabThanhCong" prefHeight="38.0" style="-fx-background-color: #E8F8F0; -fx-background-radius: 10; -fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;" text="✔ Thành công (0)">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>

                                                <!-- Tab Chờ xử lý (Vàng) -->
                                                <Button fx:id="btnTabChoXuLy" onAction="#onChonTabChoXuLy" prefHeight="38.0" style="-fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-text-fill: #D97706; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;" text="⏳ Chờ xử lý (0)">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>

                                                <!-- Tab Thất bại (Đỏ) -->
                                                <Button fx:id="btnTabThatBai" onAction="#onChonTabThatBai" prefHeight="38.0" style="-fx-background-color: #FDECEC; -fx-background-radius: 10; -fx-text-fill: #D9534F; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;" text="✕ Thất bại (0)">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>

                                                <!-- Tab Đã hủy (Xám) -->
                                                <Button fx:id="btnTabDaHuy" onAction="#onChonTabDaHuy" prefHeight="38.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;" text="⊘ Đã hủy (0)">
                                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- BẢNG DANH SÁCH GIAO DỊCH -->
                                <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(17,20,38,0.08), 18, 0.15, 0, 5);" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="CHI TIẾT DANH SÁCH GIAO DỊCH" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblSoLuongGD" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="Tổng số: 0 giao dịch" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tblGiaoDich" minHeight="380.0" prefHeight="420.0" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-border-radius: 10;">
                                            <columns>
                                                <TableColumn fx:id="colPhanLoai" prefWidth="90.0" text="Loại" />
                                                <TableColumn fx:id="colTKLienQuan" prefWidth="180.0" text="Tài khoản đối ứng" />
                                                <TableColumn fx:id="colSoTien" prefWidth="180.0" text="Số tiền tăng / giảm" />
                                                <TableColumn fx:id="colNgayGD" prefWidth="170.0" text="Ngày giao dịch" />
                                                <TableColumn fx:id="colNoiDung" prefWidth="250.0" text="Nội dung" />
                                                <TableColumn fx:id="colTrangThai" prefWidth="130.0" text="Trạng thái" />
                                                <TableColumn fx:id="colThaoTac" prefWidth="120.0" text="Thao tác" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>

        <!-- ============================================================== -->
        <!-- POPUP MODAL: CHI TIẾT GIAO DỊCH                                -->
        <!-- ============================================================== -->
        <VBox fx:id="modalChiTietGD" alignment="CENTER" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
            <children>
                <VBox maxWidth="520.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 26; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0.2, 0, 8);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="CHI TIẾT GIAO DỊCH CHUYỂN TIỀN" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onDongModalChiTiet" style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: #94A3B8; -fx-cursor: hand;" text="✕" />
                            </children>
                        </HBox>
                        <Separator />

                        <VBox spacing="10.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 14; -fx-padding: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 14;">
                            <children>
                                <GridPane hgap="12.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="40.0" />
                                        <ColumnConstraints percentWidth="60.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Mã giao dịch:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <Label fx:id="lblModalMaGD" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5148C9;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Tài khoản gửi:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <Label fx:id="lblModalTKGui" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Tài khoản nhận:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <Label fx:id="lblModalTKNhan" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Loại giao dịch:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <Label fx:id="lblModalLoaiGD" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Số tiền:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                        <Label fx:id="lblModalSoTien" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Thời gian:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                        <Label fx:id="lblModalThoiGian" style="-fx-font-size: 12px;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Nội dung:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                                        <Label fx:id="lblModalNoiDung" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" text="..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                                        <Label fx:id="lblModalTrangThai" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="..." GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#onDongModalChiTiet" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #5148C9; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đóng">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
