                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button onAction="#onDongModalChiTiet" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #5148C9; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đóng">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- ============================================================== -->
        <!-- POPUP MODAL 2: XÁC NHẬN ĐĂNG XUẤT                              -->
        <!-- ============================================================== -->
        <VBox fx:id="modalXacNhanDangXuat" alignment="CENTER" managed="false" style="-fx-background-color: rgba(15, 23, 42, 0.65);" visible="false">
            <children>
                <VBox maxWidth="420.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0.2, 0, 8);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #171A35;" text="XÁC NHẬN ĐĂNG XUẤT" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onDongModalDangXuat" style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: #94A3B8; -fx-cursor: hand;" text="✕" />
                            </children>
                        </HBox>
                        <Separator />

                        <Label style="-fx-font-size: 13px; -fx-text-fill: #4B5563;" text="Bạn có chắc chắn muốn đăng xuất khỏi phiên làm việc này?" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button onAction="#onDongModalDangXuat" prefHeight="38.0" prefWidth="90.0" style="-fx-background-color: #F1F2F6; -fx-background-radius: 10; -fx-text-fill: #555A70; -fx-font-weight: bold; -fx-cursor: hand;" text="Hủy">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                                <Button onAction="#onXacNhanDangXuatThucTe" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #D9534F; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng xuất">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
