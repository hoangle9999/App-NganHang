<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="450" spacing="15" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.appnganhang.LoginController">

    <padding>
        <Insets bottom="40" left="50" right="50" top="40" />
    </padding>

    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e3d59;" text="NGÂN HÀNG" />

    <Label style="-fx-font-size: 16px; -fx-text-fill: #438a5e; -fx-font-weight: bold;" text="HỆ THỐNG CHUYỂN TIỀN" />

    <VBox maxWidth="350" spacing="10" style="-fx-padding: 20 0 10 0;">
        <Label style="-fx-font-weight: bold;" text="Tên đăng nhập" />
        <TextField fx:id="txtTenDangNhap" prefHeight="35" promptText="Nhập tên đăng nhập" />

        <Label style="-fx-font-weight: bold;" text="Mật khẩu" />
        <PasswordField fx:id="txtMatKhau" prefHeight="35" promptText="Nhập mật khẩu" />
    </VBox>

    <Button onAction="#onLoginButtonClick" prefHeight="40" prefWidth="350" style="-fx-background-color: #1e3d59; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ĐĂNG NHẬP" />

    <Button onAction="#onExitButtonClick" prefHeight="40" prefWidth="350" style="-fx-background-color: #e8e8e8; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-cursor: hand;" text="THOÁT" />

    <Label style="-fx-text-fill: gray; -fx-font-size: 11px;" text="Vui lòng đăng nhập để sử dụng hệ thống" />

    <Label fx:id="lblThongBao" style="-fx-text-fill: red;" text="" />

    <Button mnemonicParsing="false" onAction="#onRegisterLinkClick" text="Đăng ký tài khoản mới" />
    
</VBox>
