<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.appnganhang.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #FAFAFF, #EEF0FF);">

    <VBox alignment="TOP_CENTER"
          maxWidth="430"
          prefWidth="430"
          spacing="0">

        <padding>
            <Insets top="35" right="35" bottom="30" left="35"/>
        </padding>

        <!-- TÊN NGÂN HÀNG -->

        <Label text="SMART BANK"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #111426;"/>

        <Label text="YOUR SMART BANKING"
               style="-fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #777B8A;"
               translateY="5"/>

        <Region prefHeight="28"/>

        <!-- BANK CARD -->

        <StackPane prefWidth="360"
                   prefHeight="205"
                   maxWidth="360"
                   maxHeight="205"
                   style="-fx-background-color: linear-gradient(to bottom right, #171A35, #4C45C7);
                          -fx-background-radius: 25;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 20, 0.2, 0, 8);">

            <VBox spacing="0">

                <padding>
                    <Insets top="22" right="25" bottom="20" left="25"/>
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <Label text="SMART BANK"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="VISA"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>

                </HBox>

                <Region prefHeight="35"/>

                <Label text="••••  ••••  ••••  4800"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Region prefHeight="15"/>

                <HBox>

                    <VBox>

                        <Label text="CARD HOLDER"
                               style="-fx-font-size: 8px;
                                      -fx-text-fill: #D8D8EE;"/>

                        <Label text="SMART BANK USER"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT">

                        <Label text="VALID THRU"
                               style="-fx-font-size: 8px;
                                      -fx-text-fill: #D8D8EE;"/>

                        <Label text="12/29"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                    </VBox>

                </HBox>

            </VBox>

        </StackPane>

        <Region prefHeight="32"/>

        <!-- WELCOME -->

        <VBox spacing="6"
              alignment="CENTER_LEFT"
              maxWidth="360">

            <Label text="Welcome back"
                   style="-fx-font-size: 27px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #111426;"/>

            <Label text="Đăng nhập để tiếp tục sử dụng dịch vụ ngân hàng"
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #777B8A;"/>

        </VBox>

        <Region prefHeight="22"/>

        <!-- TÊN ĐĂNG NHẬP -->

        <VBox spacing="7"
              maxWidth="360">

            <Label text="Tên đăng nhập"
                   style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #343746;"/>

            <TextField fx:id="txtTenDangNhap"
                       prefHeight="48"
                       maxWidth="360"
                       promptText="Nhập tên đăng nhập"
                       style="-fx-background-color: white;
                              -fx-background-radius: 13;
                              -fx-border-color: #E0E1E8;
                              -fx-border-radius: 13;
                              -fx-border-width: 1;
                              -fx-padding: 0 15;
                              -fx-font-size: 13px;"/>

        </VBox>

        <Region prefHeight="15"/>

        <!-- MẬT KHẨU -->

        <VBox spacing="7"
              maxWidth="360">

            <Label text="Mật khẩu"
                   style="-fx-font-size: 12px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #343746;"/>

            <PasswordField fx:id="txtMatKhau"
                           prefHeight="48"
                           maxWidth="360"
                           promptText="Nhập mật khẩu"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 13;
                                  -fx-border-color: #E0E1E8;
                                  -fx-border-radius: 13;
                                  -fx-border-width: 1;
                                  -fx-padding: 0 15;
                                  -fx-font-size: 13px;"/>

        </VBox>

        <Region prefHeight="8"/>

        <!-- THÔNG BÁO -->

        <Label fx:id="lblThongBao"
               maxWidth="360"
               minHeight="18"
               wrapText="true"
               style="-fx-font-size: 11px;
                      -fx-text-fill: #E53935;"/>

        <Region prefHeight="5"/>

        <!-- ĐĂNG NHẬP -->

        <Button text="ĐĂNG NHẬP"
                onAction="#onLoginButtonClick"
                mnemonicParsing="false"
                prefHeight="50"
                maxWidth="360"
                style="-fx-background-color: #111426;
                       -fx-background-radius: 14;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Region prefHeight="18"/>

        <!-- ĐĂNG KÝ -->

        <HBox alignment="CENTER"
              spacing="5">

            <Label text="Chưa có tài khoản?"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #777B8A;"/>

            <Button text="Đăng ký"
                    mnemonicParsing="false"
                    onAction="#onRegisterLinkClick"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #635BDB;
                           -fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-padding: 0;
                           -fx-cursor: hand;"/>

        </HBox>

        <Region prefHeight="8"/>

        <!-- THOÁT -->

        <Button text="Thoát"
                mnemonicParsing="false"
                onAction="#onExitButtonClick"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #999AAA;
                       -fx-font-size: 11px;
                       -fx-cursor: hand;"/>

    </VBox>

</StackPane>