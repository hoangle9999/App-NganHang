<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.DoiMatKhauController"
            prefWidth="1280"
            prefHeight="760"
            style="-fx-background-color: #F7F8FC;">

    <!-- ================= SIDEBAR TRÁI ================= -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #262261;"
              spacing="8">
            <padding>
                <Insets top="25" right="15" bottom="20" left="20"/>
            </padding>

            <!-- Logo / Brand -->
            <Label text="SMART BANK"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="YOUR SMART BANKING"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;"/>

            <Region prefHeight="15"/>

            <!-- User Info Box -->
            <VBox style="-fx-background-color: rgba(255, 255, 255, 0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;"
                  spacing="3">
                <Label text="Xin chào"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #A0A0C0;"/>
                <Label text="Người dùng"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
            </VBox>

            <Region prefHeight="10"/>
            <Label text="MENU"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;
                          -fx-padding: 0 0 5 5;"/>

            <!-- Danh sách menu điều hướng dọc -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button text="Khách hàng" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Tài khoản" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chuyển tiền" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Tra cứu giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Lịch sử giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Hạn mức" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Loại giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chi nhánh" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Nhân viên" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Báo cáo" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>

                <!-- Mục đang chọn: Đổi mật khẩu -->
                <Button text="Đổi mật khẩu"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: rgba(255, 255, 255, 0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"/>
            </VBox>

            <!-- Đăng xuất -->
            <Button text="Đăng xuất"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: rgba(255, 255, 255, 0.08);
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH BÊN PHẢI ================= -->
    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- Header phải -->
            <top>
                <VBox spacing="5">
                    <VBox spacing="4">
                        <Label text="Đổi mật khẩu"
                               style="-fx-font-size: 26px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>
                        <Label text="Cập nhật mật khẩu tài khoản bảo mật của bạn"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #85879A;"/>
                    </VBox>
                    <Region prefHeight="15"/>
                </VBox>
            </top>

            <!-- Center phải: Form đổi mật khẩu đặt trong card trắng gọn gàng -->
            <center>
                <VBox alignment="CENTER_LEFT">
                    <VBox maxWidth="480.0"
                          spacing="15.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-border-color: #E6E7EF;
                                 -fx-border-radius: 16;
                                 -fx-border-width: 1;">
                        <padding>
                            <Insets top="30.0"
                                    right="30.0"
                                    bottom="30.0"
                                    left="30.0"/>
                        </padding>

                        <Label text="Thông tin bảo mật"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>

                        <Label fx:id="lblTenDangNhap"
                               text="Tên đăng nhập: ..."
                               style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-font-weight: bold;"/>

                        <PasswordField fx:id="txtMatKhauCu"
                                       prefHeight="40.0"
                                       promptText="Nhập mật khẩu hiện tại"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>

                        <PasswordField fx:id="txtMatKhauMoi"
                                       prefHeight="40.0"
                                       promptText="Nhập mật khẩu mới"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>

                        <PasswordField fx:id="txtXacNhanMatKhau"
                                       prefHeight="40.0"
                                       promptText="Xác nhận mật khẩu mới"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 10; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>

                        <Label fx:id="lblThongBao"
                               text=""
                               style="-fx-font-size: 12px;"/>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button fx:id="btnDoiMatKhau"
                                    mnemonicParsing="false"
                                    prefHeight="40.0"
                                    prefWidth="180.0"
                                    text="Đổi mật khẩu"
                                    style="-fx-background-color: #5148C9; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

                            <Button fx:id="btnHuy"
                                    mnemonicParsing="false"
                                    prefHeight="40.0"
                                    prefWidth="130.0"
                                    text="Hủy"
                                    style="-fx-background-color: #F1F2F6; -fx-background-radius: 10; -fx-text-fill: #4B5563; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>