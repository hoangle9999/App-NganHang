<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.appnganhang.controller.TraCuuGiaoDichController"
            prefWidth="1280"
            prefHeight="760"
            style="-fx-background-color: #F7F8FC;">

    <!-- ================= SIDEBAR TRÁI ================= -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #262261;"
              spacing="8">
            <padding>
                <Insets top="25" right="15" bottom="20" left="20"/>
            </padding>

            <!-- Logo / Brand -->
            <Label text="SMART BANK"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="YOUR SMART BANKING"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;"/>

            <Region prefHeight="15"/>

            <!-- User Info Box -->
            <VBox style="-fx-background-color: rgba(255, 255, 255, 0.08);
                         -fx-background-radius: 12;
                         -fx-padding: 12 15;"
                  spacing="3">
                <Label text="Xin chào"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #A0A0C0;"/>
                <Label text="Người dùng"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
            </VBox>

            <Region prefHeight="10"/>
            <Label text="MENU"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #A0A0C0;
                          -fx-padding: 0 0 5 5;"/>

            <!-- Danh sách menu điều hướng dọc -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button text="Khách hàng" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Tài khoản" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chuyển tiền" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>

                <!-- Mục đang chọn: Tra cứu giao dịch -->
                <Button text="Tra cứu giao dịch"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        style="-fx-background-color: rgba(255, 255, 255, 0.15);
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 12;
                               -fx-cursor: hand;"/>

                <Button text="Lịch sử giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Hạn mức" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Loại giao dịch" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Chi nhánh" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Nhân viên" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Báo cáo" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
                <Button text="Đổi mật khẩu" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #D0D0E0; -fx-font-size: 13px; -fx-padding: 10 12; -fx-cursor: hand;"/>
            </VBox>

            <!-- Đăng xuất -->
            <Button text="Đăng xuất"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: rgba(255, 255, 255, 0.08);
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-padding: 10 12;
                           -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ================= NỘI DUNG CHÍNH BÊN PHẢI ================= -->
    <center>
        <BorderPane style="-fx-background-color: #F7F8FC;">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- Header phải & Khung tìm kiếm / Tra cứu -->
            <top>
                <VBox spacing="15">
                    <VBox spacing="4">
                        <Label text="Tra cứu giao dịch"
                               style="-fx-font-size: 26px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>
                        <Label text="Tìm kiếm và tra cứu chi tiết các giao dịch trong hệ thống ngân hàng"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #85879A;"/>
                    </VBox>

                    <!-- Khung card chứa bộ lọc tìm kiếm -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E6E7EF;
                                 -fx-border-radius: 14;
                                 -fx-border-width: 1;">
                        <padding>
                            <Insets top="16" right="20" bottom="16" left="20"/>
                        </padding>
                        <Label text="Bộ lọc tìm kiếm"
                               style="-fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #171A35;"/>

                        <!-- Hàng nhập liệu thứ nhất -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <TextField fx:id="txtMaGiaoDich"
                                       prefWidth="180.0"
                                       promptText="Mã giao dịch"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 8; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;"/>

                            <TextField fx:id="txtMaTaiKhoan"
                                       prefWidth="180.0"
                                       promptText="Mã tài khoản"
                                       style="-fx-background-color: #F7F8FC; -fx-background-radius: 8; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;"/>

                            <ComboBox fx:id="cboLoaiGiaoDich"
                                      prefWidth="170.0"
                                      promptText="Loại giao dịch"
                                      style="-fx-background-color: #F7F8FC; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>

                            <ComboBox fx:id="cboTrangThai"
                                      prefWidth="150.0"
                                      promptText="Trạng thái"
                                      style="-fx-background-color: #F7F8FC; -fx-border-color: #E6E7EF; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>

                            <Button fx:id="btnTimKiem"
                                    mnemonicParsing="false"
                                    text="Tìm kiếm"
                                    prefWidth="110.0"
                                    style="-fx-background-color: #5148C9; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Hàng nút chức năng tra cứu chuyên sâu / làm mới -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Button fx:id="btnTheoMa"
                                    mnemonicParsing="false"
                                    text="Theo mã giao dịch"
                                    style="-fx-background-color: #E9E8FF; -fx-background-radius: 8; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-padding: 8 12; -fx-cursor: hand;"/>

                            <Button fx:id="btnTheoTaiKhoan"
                                    mnemonicParsing="false"
                                    text="Theo tài khoản"
                                    style="-fx-background-color: #E9E8FF; -fx-background-radius: 8; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-padding: 8 12; -fx-cursor: hand;"/>

                            <Button fx:id="btnTheoLoai"
                                    mnemonicParsing="false"
                                    text="Theo loại"
                                    style="-fx-background-color: #E9E8FF; -fx-background-radius: 8; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-padding: 8 12; -fx-cursor: hand;"/>

                            <Button fx:id="btnTheoTrangThai"
                                    mnemonicParsing="false"
                                    text="Theo trạng thái"
                                    style="-fx-background-color: #E9E8FF; -fx-background-radius: 8; -fx-text-fill: #5148C9; -fx-font-weight: bold; -fx-padding: 8 12; -fx-cursor: hand;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnLamMoi"
                                    mnemonicParsing="false"
                                    text="Làm mới"
                                    prefWidth="110.0"
                                    style="-fx-background-color: #F1F2F6; -fx-background-radius: 8; -fx-text-fill: #4B5563; -fx-font-weight: bold; -fx-padding: 8 0; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </top>

            <!-- Center phải: Bảng hiển thị giao dịch -->
            <center>
                <VBox spacing="12">
                    <Region prefHeight="5"/>
                    <TableView fx:id="tblGiaoDich"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: #E6E7EF; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colMaGiaoDich"
                                         prefWidth="120.0"
                                         text="Mã giao dịch"/>
                            <TableColumn fx:id="colTaiKhoanNguon"
                                         prefWidth="130.0"
                                         text="TK nguồn"/>
                            <TableColumn fx:id="colTaiKhoanDich"
                                         prefWidth="130.0"
                                         text="TK đích"/>
                            <TableColumn fx:id="colSoTien"
                                         prefWidth="120.0"
                                         text="Số tiền"/>
                            <TableColumn fx:id="colNgayGiaoDich"
                                         prefWidth="160.0"
                                         text="Ngày giao dịch"/>
                            <TableColumn fx:id="colNoiDung"
                                         prefWidth="180.0"
                                         text="Nội dung"/>
                            <TableColumn fx:id="colMaLoaiGD"
                                         prefWidth="110.0"
                                         text="Mã loại GD"/>
                            <TableColumn fx:id="colTrangThai"
                                         prefWidth="110.0"
                                         text="Trạng thái"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>